from typing import Any

STATE_DIRNAME = ".orca"
STATE_FILENAME = "ai-team.json"
WATCH_LOG_FILENAME = "ai-team-watch.log"
# Project-root handoff so the next `orca-team start` can resume context.
HANDOFF_FILENAME = "AI-TEAM-HANDOFF.md"
HANDOFF_MAX_CHARS = 12_000
DEFAULT_WATCH_INTERVAL = 60
DEFAULT_WATCH_STALE_MINUTES = 15.0
# Skip opening/assigning workers below this remaining usage % (best-effort probes).
DEFAULT_MIN_REMAINING_PERCENT = 10.0
# Layout: dual = orchestrator alone in one tab, all workers split in a second tab.
DEFAULT_LAYOUT = "dual"
ORCH_TAB_TITLE = "ai-team:orch"
WORKERS_TAB_TITLE = "ai-team:workers"
DEFAULT_ORCHESTRATOR = "claude-opus"
# command-code is omitted from room pre-open: it rewrites argv + runs onboarding,
# so Orca inject/prompts often stall. Spawn it on demand via worker-start --agent.
DEFAULT_WORKERS = ["claude-sonnet", "grok", "pi"]
# User defaults: ~/.config/orca-ai-team/config.json (override with ORCA_TEAM_CONFIG).
CONFIG_DIRNAME = "orca-ai-team"
CONFIG_FILENAME = "config.json"
CONFIG_ENV = "ORCA_TEAM_CONFIG"
# Agents listed here are still allowed as --workers, but start() does not open a pane.
# Orchestrator must use: worker-start --worktree current --agent <id>
DEFERRED_AGENTS = frozenset({"command-code"})
IDLE_TIMEOUT_MS = 180_000
# Tail markers that mean "safe to send a prompt" (case-insensitive substring match).
AGENT_READY_MARKERS: dict[str, tuple[str, ...]] = {
    "command-code": (
        "ask your question",
        "permission bypass",
        "? for shortcuts",
        "❯",
    ),
    "claude-opus": ("bypass permissions", "❯", "※", "claude"),
    "claude-sonnet": ("bypass permissions", "❯", "※", "claude"),
    "claude": ("bypass permissions", "❯"),
    "grok": ("always-approve", "grok", "❯"),
    "pi": ("pi ready", "❯"),
}
SKILL_ROOT = Path(__file__).resolve().parents[1]
ROLE_PROMPTS_PATH = SKILL_ROOT / "references" / "role-prompts.md"
VERSION_PATH = SKILL_ROOT / "VERSION"


def package_version() -> str:
    try:
        return VERSION_PATH.read_text(encoding="utf-8").strip() or "0.0.0"
    except OSError:
        return "0.0.0"

# Explicit argv — Orca terminal create does not expand shell aliases.
AGENT_LAUNCH: dict[str, list[str]] = {
    # Claude variants (orchestrator default = Opus; Sonnet is a worker)
    "claude-opus": ["claude", "--dangerously-skip-permissions", "--model", "opus"],
    "claude-sonnet": ["claude", "--dangerously-skip-permissions", "--model", "sonnet"],
    # Back-compat aliases
    "claude": ["claude", "--dangerously-skip-permissions", "--model", "sonnet"],
    "opus": ["claude", "--dangerously-skip-permissions", "--model", "opus"],
    "sonnet": ["claude", "--dangerously-skip-permissions", "--model", "sonnet"],
    "grok": ["grok", "--always-approve"],
    # --trust/--skip-onboarding keep the TUI from exiting to a bare shell before inject.
    "command-code": [
        "command-code",
        "--yolo",
        "--trust",
        "--skip-onboarding",
    ],
    "codex": ["codex", "--dangerously-bypass-approvals-and-sandbox"],
    "opencode": ["opencode", "--auto"],
    "pi": ["pi", "--approve"],
}

AGENT_BINARIES: dict[str, str] = {
    "claude-opus": "claude",
    "claude-sonnet": "claude",
    "claude": "claude",
    "opus": "claude",
    "sonnet": "claude",
    "grok": "grok",
    "command-code": "command-code",
    "codex": "codex",
    "opencode": "opencode",
    "pi": "pi",
}


def is_claude_agent(agent_id: str) -> bool:
    return agent_id.startswith("claude") or agent_id in {"opus", "sonnet"}


class TeamError(Exception):
    pass


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _looks_like_gnome_orca(path: str) -> bool:
    """True when PATH `orca` is the GNOME screen reader, not the Orca IDE CLI."""
    resolved = os.path.realpath(path)
    if resolved in {"/usr/bin/orca", "/bin/orca"}:
        return True
    try:
        with open(path, "rb") as fh:
            head = fh.read(256)
    except OSError:
        return False
    # Packaged Orca CLI shims are tiny shell/python launchers mentioning orca-ide / runtime.
    if b"GNOME" in head or b"speech" in head.lower():
        return True
    return False


def resolve_orca() -> str:
    env = os.environ.get("ORCA_CLI_COMMAND")
    if env:
        return env
    if os.environ.get("ORCA_DEV_REPO_ROOT"):
        path = shutil.which("orca-dev")
        if path:
            return path
        raise TeamError("ORCA_DEV_REPO_ROOT is set but orca-dev was not found on PATH")

    orca_path = shutil.which("orca")
    # Prefer a non-GNOME `orca` shim (e.g. ~/.local/bin/orca) — it talks to the running app.
    if orca_path and not _looks_like_gnome_orca(orca_path):
        return orca_path

    # Linux fallback: orca-ide. Avoid GNOME /usr/bin/orca.
    if sys.platform.startswith("linux") and not os.environ.get("ORCA_TERMINAL_HANDLE"):
        path = shutil.which("orca-ide")
        if path:
            return path
        raise TeamError(
            "No usable Orca CLI found. Install the Orca CLI shim or orca-ide "
            "(bare /usr/bin/orca is the GNOME screen reader)."
        )

    if orca_path:
        return orca_path
    raise TeamError("orca CLI not found on PATH")


def orca_json(orca: str, args: list[str], *, check: bool = True) -> dict[str, Any]:
    cmd = [orca, *args, "--json"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except FileNotFoundError as exc:
        raise TeamError(f"failed to execute {orca}: {exc}") from exc
    stdout = (proc.stdout or "").strip()
    stderr = (proc.stderr or "").strip()
    # Keepalive lines are on stderr for check --wait; ignore stderr for parsing.
    if not stdout:
        raise TeamError(
            f"orca returned empty JSON for {' '.join(args)}: "
            f"{stderr or f'exit {proc.returncode}'}"
        )
    payload: dict[str, Any] | None = None
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError:
        # Some commands may print multiple JSON docs; take the last object.
        for line in reversed(stdout.splitlines()):
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                payload = json.loads(line)
                break
            except json.JSONDecodeError:
                continue
    if payload is None:
        raise TeamError(f"could not parse JSON from {' '.join(args)}:\n{stdout[:1000]}")
    if check and not payload.get("ok", True):
        err = payload.get("error") or {}
        code = err.get("code", "error")
        msg = err.get("message", json.dumps(err)[:500])
        raise TeamError(f"{code}: {msg}")
    return payload


def unwrap(payload: dict[str, Any]) -> Any:
    return payload.get("result", payload)


def launch_argv(agent_id: str, model: str | None = None) -> list[str]:
    """Return launch argv for an agent, optionally overriding the model."""
    if agent_id not in AGENT_LAUNCH:
        known = ", ".join(sorted(AGENT_LAUNCH))
        raise TeamError(f"unknown agent id '{agent_id}'. Known: {known}")
    argv = list(AGENT_LAUNCH[agent_id])
    model_s = (model or "").strip() or None
    if not model_s:
        return argv

    # Claude family already has `--model <alias>` in AGENT_LAUNCH — replace it.
    if is_claude_agent(agent_id):
        out: list[str] = []
        i = 0
        replaced = False
        while i < len(argv):
            if argv[i] == "--model" and i + 1 < len(argv):
                out.extend(["--model", model_s])
                i += 2
                replaced = True
                continue
            out.append(argv[i])
            i += 1
        if not replaced:
            out.extend(["--model", model_s])
        return out

    if agent_id == "grok":
        # Prefer long form; drop prior -m/--model pairs if present.
        out = []
        i = 0
        while i < len(argv):
            if argv[i] in {"-m", "--model"} and i + 1 < len(argv):
                i += 2
                continue
            out.append(argv[i])
            i += 1
        out.extend(["--model", model_s])
        return out

    if agent_id == "pi":
        out = []
        i = 0
        while i < len(argv):
            if argv[i] == "--model" and i + 1 < len(argv):
                i += 2
                continue
            out.append(argv[i])
            i += 1
        out.extend(["--model", model_s])
        return out

    # command-code / codex / opencode: no reliable portable model flag here.
    eprint(
        f"warning: model override '{model_s}' ignored for agent '{agent_id}' "
        "(no known launch flag)"
    )
    return argv


def launch_command(agent_id: str, model: str | None = None) -> str:
    return " ".join(launch_argv(agent_id, model=model))


def binary_for(agent_id: str) -> str:
    return AGENT_BINARIES.get(agent_id, agent_id)


def parse_agent_list(raw: str | None, default: list[str]) -> list[str]:
    if raw is None or raw.strip() == "":
        return list(default)
    agents = [part.strip() for part in raw.split(",") if part.strip()]
    if not agents:
        return list(default)
    for agent in agents:
        if agent not in AGENT_LAUNCH:
            known = ", ".join(sorted(AGENT_LAUNCH))
            raise TeamError(f"unknown agent id '{agent}'. Known: {known}")
    return agents


def parse_worker_models(raw: str | None) -> dict[str, str]:
    """Parse `agent=model,agent2=model2` into a dict."""
    out: dict[str, str] = {}
    if not raw or not str(raw).strip():
        return out
    for part in str(raw).split(","):
        part = part.strip()
        if not part:
            continue
        if "=" not in part:
            raise TeamError(
                f"invalid --worker-models entry '{part}' (expected agent=model)"
            )
        agent, model = part.split("=", 1)
        agent = agent.strip()
        model = model.strip()
        if not agent or not model:
            raise TeamError(
                f"invalid --worker-models entry '{part}' (expected agent=model)"
            )
        if agent not in AGENT_LAUNCH:
            known = ", ".join(sorted(AGENT_LAUNCH))
            raise TeamError(f"unknown agent id '{agent}' in --worker-models. Known: {known}")
        out[agent] = model
    return out


def default_config_dict() -> dict[str, Any]:
    return {
        "version": 1,
        "orchestrator": DEFAULT_ORCHESTRATOR,
        "workers": list(DEFAULT_WORKERS),
        "models": {},
    }


def config_path() -> Path:
    override = (os.environ.get(CONFIG_ENV) or "").strip()
    if override:
        return Path(override).expanduser().resolve()
    xdg = (os.environ.get("XDG_CONFIG_HOME") or "").strip()
    base = Path(xdg).expanduser() if xdg else Path.home() / ".config"
    return (base / CONFIG_DIRNAME / CONFIG_FILENAME).resolve()


def load_user_config() -> dict[str, Any] | None:
    """Load user config or return None if missing. Raises TeamError if corrupt/invalid."""
    path = config_path()
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise TeamError(f"could not read config {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise TeamError(f"config {path} must be a JSON object")
    return normalize_user_config(data, path=path)


def normalize_user_config(
    data: dict[str, Any], *, path: Path | None = None
) -> dict[str, Any]:
    loc = f" in {path}" if path else ""
    out = default_config_dict()
    orch = data.get("orchestrator", out["orchestrator"])
    if not isinstance(orch, str) or orch not in AGENT_LAUNCH:
        raise TeamError(
            f"config{loc}: unknown orchestrator '{orch}'. "
            f"Known: {', '.join(sorted(AGENT_LAUNCH))}"
        )
    out["orchestrator"] = orch
    workers_raw = data.get("workers", out["workers"])
    if not isinstance(workers_raw, list) or not all(isinstance(w, str) for w in workers_raw):
        raise TeamError(f"config{loc}: workers must be a JSON array of strings")
    workers: list[str] = []
    for w in workers_raw:
        if w not in AGENT_LAUNCH:
            raise TeamError(
                f"config{loc}: unknown worker '{w}'. "
                f"Known: {', '.join(sorted(AGENT_LAUNCH))}"
            )
        if w not in workers:
            workers.append(w)
    out["workers"] = workers
    models_raw = data.get("models") or {}
    if not isinstance(models_raw, dict):
        raise TeamError(f"config{loc}: models must be a JSON object")
    models: dict[str, str] = {}
    for k, v in models_raw.items():
        if not isinstance(k, str):
            raise TeamError(f"config{loc}: models keys must be strings")
        if k not in AGENT_LAUNCH:
            raise TeamError(
                f"config{loc}: unknown agent '{k}' in models. "
                f"Known: {', '.join(sorted(AGENT_LAUNCH))}"
            )
        if v is None:
            continue
        if not isinstance(v, str) or not v.strip():
            raise TeamError(f"config{loc}: models['{k}'] must be a string or null")
        models[k] = v.strip()
    out["models"] = models
    out["version"] = 1
    return out


def save_user_config(data: dict[str, Any]) -> Path:
    path = config_path()
    normalized = normalize_user_config(data, path=path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(normalized, indent=2) + "\n", encoding="utf-8")
    return path


def resolve_start_roster(
    args: argparse.Namespace,
) -> tuple[str, list[str], dict[str, str | None], bool]:
    """
    Resolve orchestrator, workers, per-agent models, and whether config file exists.

    Returns (orchestrator, workers, models_by_agent, config_present).
    models_by_agent values may be None (use built-in launch model).
    """
    cfg = load_user_config()
    config_present = cfg is not None
    base = cfg or default_config_dict()

    # argparse: None means "not passed" so config can apply.
    orch_flag = getattr(args, "orchestrator", None)
    workers_flag = getattr(args, "workers", None)
    orchestrator = (
        str(orch_flag)
        if orch_flag
        else str(base.get("orchestrator") or DEFAULT_ORCHESTRATOR)
    )
    if orchestrator not in AGENT_LAUNCH:
        raise TeamError(f"unknown orchestrator '{orchestrator}'")

    if workers_flag is None or str(workers_flag).strip() == "":
        workers = list(base.get("workers") or DEFAULT_WORKERS)
    else:
        workers = parse_agent_list(str(workers_flag), list(DEFAULT_WORKERS))

    models: dict[str, str | None] = {
        aid: None for aid in {orchestrator, *workers}
    }
    for aid, model in (base.get("models") or {}).items():
        if aid in models and isinstance(model, str) and model.strip():
            models[aid] = model.strip()

    orch_model = (getattr(args, "orchestrator_model", None) or "").strip()
    if orch_model:
        models[orchestrator] = orch_model

    for aid, model in parse_worker_models(getattr(args, "worker_models", None)).items():
        models[aid] = model

    return orchestrator, workers, models, config_present


def find_worktree(orca: str, cwd: Path) -> dict[str, Any]:
    payload = orca_json(orca, ["worktree", "current"], check=False)
    if payload.get("ok"):
        wt = unwrap(payload).get("worktree") or unwrap(payload)
        if isinstance(wt, dict) and wt.get("path"):
            return wt
    # Fallback: match cwd against listed worktrees.
    listed = orca_json(orca, ["worktree", "list"])
    result = unwrap(listed)
    items = result if isinstance(result, list) else result.get("worktrees") or result.get("items") or []
    cwd_resolved = cwd.resolve()
    for item in items:
        path = Path(item.get("path", "")).resolve()
        if cwd_resolved == path or path in cwd_resolved.parents or cwd_resolved in path.parents:
            # Prefer exact / deepest containment.
            if cwd_resolved == path or path in cwd_resolved.parents:
                return item
    raise TeamError(
        f"No Orca-managed worktree contains the current directory: {cwd}\n"
        "Open a worktree in Orca (or cd into one), then retry."
    )


def state_path_for(worktree_path: Path) -> Path:
    return worktree_path / STATE_DIRNAME / STATE_FILENAME


def watch_log_path_for(worktree_path: Path) -> Path:
    return worktree_path / STATE_DIRNAME / WATCH_LOG_FILENAME


def delete_watch_log(worktree_path: Path) -> bool:
    """Remove `.orca/ai-team-watch.log` if present. Returns True when a file was deleted."""
    path = watch_log_path_for(worktree_path)
    try:
        if path.is_file():
            path.unlink()
            return True
    except OSError as exc:
        eprint(f"warning: could not delete watch log {path}: {exc}")
    return False


def handoff_path_for(worktree_path: Path) -> Path:
    return worktree_path / HANDOFF_FILENAME


def _http_get_json(url: str, *, headers: dict[str, str], timeout: float = 15.0) -> dict[str, Any] | None:
    import urllib.error
    import urllib.request

    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
        data = json.loads(raw)
        return data if isinstance(data, dict) else None
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError, OSError):
        return None


def probe_grok_usage() -> dict[str, Any]:
    """Query Grok Build weekly credit usage via cli-chat-proxy (same as /usage)."""
    auth_path = Path.home() / ".grok" / "auth.json"
    out: dict[str, Any] = {
        "agentId": "grok",
        "ok": False,
        "remainingPercent": None,
        "usedPercent": None,
        "source": "grok-billing",
        "detail": "",
    }
    if not auth_path.is_file():
        out["detail"] = "missing ~/.grok/auth.json"
        return out
    try:
        auth = json.loads(auth_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        out["detail"] = f"auth read error: {exc}"
        return out
    entry = next(
        (v for v in auth.values() if isinstance(v, dict) and v.get("key")),
        None,
    )
    if not entry:
        out["detail"] = "no grok access token in auth.json"
        return out
    token = str(entry.get("key") or "")
    data = _http_get_json(
        "https://cli-chat-proxy.grok.com/v1/billing?format=credits",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            "User-Agent": "orca-team-usage",
        },
    )
    if not data:
        out["detail"] = "billing request failed (token expired? re-login with `grok`)"
        return out
    cfg = data.get("config") if isinstance(data.get("config"), dict) else data
    used = cfg.get("creditUsagePercent")
    if used is None:
        products = cfg.get("productUsage") or []
        if isinstance(products, list) and products:
            used = (products[0] or {}).get("usagePercent")
    try:
        used_f = float(used)
    except (TypeError, ValueError):
        out["detail"] = f"unexpected billing payload keys={list(cfg.keys())[:8]}"
        return out
    remaining = max(0.0, 100.0 - used_f)
    period = cfg.get("currentPeriod") if isinstance(cfg.get("currentPeriod"), dict) else {}
    out.update(
        {
            "ok": True,
            "usedPercent": used_f,
            "remainingPercent": remaining,
            "detail": (
                f"GrokBuild weekly {used_f:.0f}% used / {remaining:.0f}% left"
                + (f" (resets {period.get('end')})" if period.get("end") else "")
            ),
            "periodEnd": period.get("end"),
        }
    )
    return out


def probe_claude_usage() -> dict[str, Any]:
    """Parse `claude /usage` text for session/week remaining %."""
    out: dict[str, Any] = {
        "agentId": "claude",
        "ok": False,
        "remainingPercent": None,
        "usedPercent": None,
        "source": "claude-/usage",
        "detail": "",
    }
    if not shutil.which("claude"):
        out["detail"] = "claude not on PATH"
        return out
    try:
        proc = subprocess.run(
            ["claude", "/usage"],
            capture_output=True,
            text=True,
            check=False,
            timeout=45,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        out["detail"] = f"claude /usage failed: {exc}"
        return out
    text = (proc.stdout or "") + "\n" + (proc.stderr or "")
    # e.g. "Current session: 30% used" / "Current week (all models): 46% used"
    used_vals: list[float] = []
    details: list[str] = []
    for label, pat in (
        ("session", re.compile(r"(?i)current session:\s*(\d+(?:\.\d+)?)\s*%\s*used")),
        ("week", re.compile(r"(?i)current week[^\n:]*:\s*(\d+(?:\.\d+)?)\s*%\s*used")),
    ):
        m = pat.search(text)
        if m:
            used_vals.append(float(m.group(1)))
            details.append(f"{label} {m.group(1)}% used")
    if not used_vals:
        out["detail"] = "could not parse claude /usage"
        return out
    used_f = max(used_vals)  # most restrictive bucket
    remaining = max(0.0, 100.0 - used_f)
    out.update(
        {
            "ok": True,
            "usedPercent": used_f,
            "remainingPercent": remaining,
            "detail": f"Claude {', '.join(details)} → {remaining:.0f}% remaining (strictest)",
        }
    )
    return out


def probe_agent_usage(agent_id: str) -> dict[str, Any]:
    """Best-effort remaining usage for a roster agent id."""
    aid = agent_id
    if is_claude_agent(aid) or aid in {"claude", "opus", "sonnet"}:
        row = probe_claude_usage()
        row["agentId"] = aid
        return row
    if aid in {"grok"}:
        return probe_grok_usage()
    # pi / command-code / codex: no reliable subscription probe yet
    return {
        "agentId": aid,
        "ok": True,
        "remainingPercent": None,
        "usedPercent": None,
        "source": "none",
        "detail": "no quota probe for this agent (treat as available)",
        "unknown": True,
    }


def usage_report(agent_ids: list[str]) -> list[dict[str, Any]]:
    seen: set[str] = set()
    rows: list[dict[str, Any]] = []
    for aid in agent_ids:
        # Deduplicate Claude probes (opus+sonnet share one pool).
        key = "claude" if is_claude_agent(aid) or aid in {"claude", "opus", "sonnet"} else aid
        if key in seen:
            # Reuse prior Claude row with this agent id label.
            base = next((r for r in rows if r.get("_pool") == key), None)
            if base:
                copy = dict(base)
                copy["agentId"] = aid
                rows.append(copy)
            continue
        seen.add(key)
        row = probe_agent_usage(aid)
        row["_pool"] = key
        rows.append(row)
    for row in rows:
        row.pop("_pool", None)
    return rows


def agent_below_quota(
    row: dict[str, Any], *, min_remaining: float
) -> bool:
    """True when we know remaining % and it is below the threshold."""
    if row.get("unknown"):
        return False
    if not row.get("ok"):
        # Failed probe: do not auto-block (could be transient), but flag.
        return False
    rem = row.get("remainingPercent")
    if rem is None:
        return False
    try:
        return float(rem) < float(min_remaining)
    except (TypeError, ValueError):
        return False


def load_handoff_text(worktree_path: Path, *, max_chars: int = HANDOFF_MAX_CHARS) -> str | None:
    path = handoff_path_for(worktree_path)
    if not path.is_file():
        return None
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    text = text.strip()
    if not text:
        return None
    if len(text) > max_chars:
        return (
            text[:max_chars]
            + f"\n\n… truncated ({len(text)} chars total; see `{HANDOFF_FILENAME}`)\n"
        )
    return text


def _git_snapshot(worktree_path: Path) -> dict[str, str]:
    out: dict[str, str] = {"branch": "", "status": "", "log": ""}
    try:
        branch = subprocess.run(
            ["git", "-C", str(worktree_path), "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        if branch.returncode == 0:
            out["branch"] = branch.stdout.strip()
        status = subprocess.run(
            ["git", "-C", str(worktree_path), "status", "--short"],
            capture_output=True,
            text=True,
            check=False,
        )
        if status.returncode == 0:
            lines = [ln for ln in status.stdout.splitlines() if ln.strip()]
            out["status"] = "\n".join(lines[:40])
            if len(lines) > 40:
                out["status"] += f"\n… ({len(lines) - 40} more)"
        log = subprocess.run(
            ["git", "-C", str(worktree_path), "log", "-5", "--oneline"],
            capture_output=True,
            text=True,
            check=False,
        )
        if log.returncode == 0:
            out["log"] = log.stdout.strip()
    except OSError:
        pass
    return out


def _redact_secrets(text: str) -> str:
    """Best-effort scrub of common secret shapes before writing handoff."""
    patterns = [
        (re.compile(r"(?i)(api[_-]?key|token|secret|password|authorization)\s*[:=]\s*\S+"), r"\1: [REDACTED]"),
        (re.compile(r"(?i)\b(sk-[a-z0-9_-]{16,})\b"), "[REDACTED_KEY]"),
        (re.compile(r"(?i)\b(ghp_[a-z0-9]{20,})\b"), "[REDACTED_TOKEN]"),
        (re.compile(r"(?i)\b(xox[baprs]-[a-z0-9-]{10,})\b"), "[REDACTED_TOKEN]"),
        (re.compile(r"(?i)\b(Bearer\s+)[A-Za-z0-9._\-]+"), r"\1[REDACTED]"),
    ]
    out = text
    for pat, repl in patterns:
        out = pat.sub(repl, out)
    return out


def collect_inbox_summaries(orca: str, *, orch_handle: str, limit: int = 25) -> list[dict[str, str]]:
    payload = orca_json(
        orca,
        ["orchestration", "inbox", "--limit", str(limit)],
        check=False,
    )
    if not payload.get("ok"):
        # Try with --from if required by runtime.
        payload = orca_json(
            orca,
            ["orchestration", "inbox", "--limit", str(limit), "--from", orch_handle],
            check=False,
        )
    if not payload.get("ok"):
        return []
    result = unwrap(payload)
    msgs = result.get("messages") or result.get("items") or []
    out: list[dict[str, str]] = []
    for m in msgs if isinstance(msgs, list) else []:
        if not isinstance(m, dict):
            continue
        mtype = str(m.get("type") or "")
        if mtype not in {"worker_done", "question", "escalation", "status", "result", "update"}:
            # Keep heartbeats out of the handoff noise.
            if mtype == "heartbeat":
                continue
        body = str(m.get("body") or "")
        out.append(
            {
                "id": str(m.get("id") or ""),
                "type": mtype or "message",
                "subject": str(m.get("subject") or ""),
                "from": str(m.get("from_handle") or m.get("from") or ""),
                "body": body[:240],
                "created": str(m.get("created_at") or ""),
            }
        )
    return out


def collect_task_summaries(orca: str, *, run_id: str, orch_handle: str) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    for status in ("dispatched", "ready", "blocked", "done", "failed"):
        payload = orca_json(
            orca,
            [
                "orchestration",
                "task-list",
                "--run",
                run_id,
                "--status",
                status,
                "--brief",
                "--from",
                orch_handle,
            ],
            check=False,
        )
        if not payload.get("ok"):
            continue
        result = unwrap(payload)
        tasks = result if isinstance(result, list) else result.get("tasks") or result.get("items") or []
        for t in tasks if isinstance(tasks, list) else []:
            if not isinstance(t, dict):
                continue
            rows.append(
                {
                    "id": str(t.get("id") or ""),
                    "status": status,
                    "spec": str(t.get("spec") or "")[:160],
                    "assignee": str(t.get("assignee_handle") or ""),
                }
            )
    return rows


def write_session_handoff(
    orca: str,
    *,
    worktree_path: Path,
    state: dict[str, Any],
) -> Path | None:
    """Write AI-TEAM-HANDOFF.md so the next team start resumes project context."""
    run_id = str(state.get("runId") or "")
    orch = next((m for m in state.get("members") or [] if m.get("role") == "orchestrator"), None)
    orch_handle = str((orch or {}).get("handle") or "")
    if run_id and orch_handle:
        orca_json(
            orca,
            ["orchestration", "run-use", "--id", run_id, "--from", orch_handle],
            check=False,
        )

    git = _git_snapshot(worktree_path)
    inbox = collect_inbox_summaries(orca, orch_handle=orch_handle) if orch_handle else []
    tasks = (
        collect_task_summaries(orca, run_id=run_id, orch_handle=orch_handle)
        if run_id and orch_handle
        else []
    )
    members = list(state.get("members") or [])
    member_lines = []
    for m in members:
        member_lines.append(
            f"- {m.get('role')}:{m.get('agentId')} handle=`{m.get('handle') or '-'}`"
            + (" (deferred)" if m.get("deferred") else "")
        )

    done_msgs = [m for m in inbox if m["type"] == "worker_done"]
    questions = [m for m in inbox if m["type"] == "question"]
    open_tasks = [t for t in tasks if t["status"] in {"dispatched", "ready", "blocked"}]
    finished_tasks = [t for t in tasks if t["status"] in {"done", "failed"}]

    lines: list[str] = [
        "# AI Team session handoff",
        "",
        "Written by `orca-team stop`. The next `orca-team start` in this worktree loads this",
        "file into the orchestrator so the new team can continue without losing context.",
        "",
        "## Meta",
        "",
        f"- Stopped at: `{utc_now()}`",
        f"- Previous runId: `{run_id or '-'}`",
        f"- Objective: {state.get('objective') or '(none)'}",
        f"- Layout: `{state.get('layout') or '-'}`",
        f"- Started at: `{state.get('startedAt') or '-'}`",
        f"- Worktree: `{worktree_path}`",
        "",
        "## Roster (last session)",
        "",
    ]
    lines.extend(member_lines or ["- (none)"])
    lines.extend(
        [
            "",
            "## Git",
            "",
            f"- Branch: `{git.get('branch') or 'unknown'}`",
            "",
            "### Recent commits",
            "",
            "```",
            git.get("log") or "(unavailable)",
            "```",
            "",
            "### Working tree (`git status --short`)",
            "",
            "```",
            git.get("status") or "(clean or unavailable)",
            "```",
            "",
            "## Open / unfinished work",
            "",
        ]
    )
    if open_tasks:
        for t in open_tasks:
            lines.append(
                f"- [{t['status']}] `{t['id']}` assignee=`{t['assignee'] or '-'}` — {t['spec']}"
            )
    else:
        lines.append("- (no open orchestration tasks listed)")

    if questions:
        lines.extend(["", "## Unresolved questions (were blocking workers)", ""])
        for q in questions[:12]:
            lines.append(f"- `{q['id']}` from `{q['from']}`: {q['body']}")

    lines.extend(["", "## Recent worker_done / results", ""])
    if done_msgs:
        for m in done_msgs[:15]:
            lines.append(
                f"- `{m['created']}` `{m['id']}` {m['subject'] or m['type']}: {m['body']}"
            )
    else:
        lines.append("- (none captured in inbox sample)")

    if finished_tasks:
        lines.extend(["", "## Finished tasks (sample)", ""])
        for t in finished_tasks[:15]:
            lines.append(f"- [{t['status']}] `{t['id']}` — {t['spec']}")

    lines.extend(
        [
            "",
            "## Next session — start here",
            "",
            "1. Read this handoff and verify git status / branch still match.",
            "2. Resume **open / unfinished** items first; do not redo completed `worker_done` work.",
            "3. Resolve any unresolved questions (or drop obsolete ones) before new dispatches.",
            "4. Prefer non-Claude workers (grok/pi/command-code) for implementation; spare Sonnet quota.",
            "5. Dispatch in the same turn as the plan split — do not invent a human-approval gate.",
            "",
            "## Notes for humans",
            "",
            "- Secrets are best-effort redacted; still avoid pasting tokens into chat.",
            f"- This file is overwritten on each `orca-team stop`. Path: `{HANDOFF_FILENAME}`.",
            "",
        ]
    )

    text = _redact_secrets("\n".join(lines))
    path = handoff_path_for(worktree_path)
    try:
        path.write_text(text, encoding="utf-8")
    except OSError as exc:
        eprint(f"warning: could not write handoff {path}: {exc}")
        return None
    # Mirror under .orca for tooling that prefers that directory.
    try:
        mirror = worktree_path / STATE_DIRNAME / HANDOFF_FILENAME
        mirror.parent.mkdir(parents=True, exist_ok=True)
        mirror.write_text(text, encoding="utf-8")
    except OSError:
        pass
    return path


def load_state(worktree_path: Path) -> dict[str, Any] | None:
    path = state_path_for(worktree_path)
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        raise TeamError(f"corrupt team state at {path}: {exc}") from exc


def save_state(worktree_path: Path, state: dict[str, Any]) -> Path:
    path = state_path_for(worktree_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2) + "\n")
    return path


LEAN_ASSIGN_MARKER = "[orca-team lean-assign]"
WORKER_ROLE_REMINDER = (
    f"{LEAN_ASSIGN_MARKER} mode=role-reminder\n"
    "Standing worker role already loaded on this pane — do not wait for a full re-inject.\n"
    "Follow prior worker rules: stay in scope; finish with worker_done or ask; never go silent.\n"
)


def list_live_handles(orca: str, worktree_path: Path) -> set[str]:
    """Return live terminal handles for a worktree (best-effort)."""
    live = orca_json(
        orca,
        ["terminal", "list", "--worktree", f"path:{worktree_path}"],
        check=False,
    )
    handles: set[str] = set()
    if not live.get("ok"):
        return handles
    result = unwrap(live)
    terms = result.get("terminals") or result.get("items") or result
    if isinstance(terms, list):
        for term in terms:
            if isinstance(term, dict) and term.get("handle"):
                handles.add(str(term["handle"]))
    return handles


def mark_role_injected(member: dict[str, Any], handle: str) -> None:
    member["roleInjectedHandle"] = handle
    member["roleInjectedAt"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def clear_role_injected(member: dict[str, Any]) -> None:
    member.pop("roleInjectedHandle", None)
    member.pop("roleInjectedAt", None)


def member_needs_role_inject(
    member: dict[str, Any],
    *,
    live_handles: set[str] | None = None,
    force: bool = False,
) -> bool:
    """True when this worker pane should get a full role inject (fresh pane)."""
    if force:
        return True
    if member.get("role") == "orchestrator":
        return True  # orch path still uses full template; caller decides
    handle = member.get("handle")
    if not handle or member.get("deferred"):
        return True
    handle_s = str(handle)
    if live_handles is not None and handle_s not in live_handles:
        clear_role_injected(member)
        return True
    injected = member.get("roleInjectedHandle")
    if not injected:
        return True
    if str(injected) != handle_s:
        return True
    return False


def build_lean_task_card(
    *,
    goal: str,
    in_scope: str = "",
    out_scope: str = "",
    done_criteria: str = "",
    run_id: str,
    task_id: str,
    dispatch_id: str,
    mode: str = "lean",
) -> str:
    """Short per-task card (R4). Raises TeamError if required fields missing."""
    goal_s = (goal or "").strip()
    done_s = (done_criteria or "").strip() or (
        "Complete the goal; list files touched; report via worker_done."
    )
    if not goal_s:
        raise TeamError("lean task card requires a goal/spec")
    if not run_id or not task_id:
        raise TeamError("lean task card requires run_id and task_id")
    paths_block = ""
    if in_scope.strip() or out_scope.strip():
        paths_block = (
            f"In-scope paths: {in_scope.strip() or '(see goal)'}\n"
            f"Out-of-scope: {out_scope.strip() or '(do not expand)'}\n"
        )
    dispatch_s = (dispatch_id or "").strip() or "(pending)"
    worker_done = (
        "orca orchestration send --type worker_done "
        f'--subject "done" --body "<what you did>" '
        f"--task-id {task_id} --dispatch-id {dispatch_s} "
        "--outcome succeeded --json"
    )
    ask_line = (
        'orca orchestration ask --question "<blocker>" --timeout-ms 600000 --json'
    )
    return (
        f"{LEAN_ASSIGN_MARKER} mode={mode}\n"
        f"GOAL: {goal_s}\n"
        f"{paths_block}"
        f"Done criteria: {done_s}\n"
        f"runId: {run_id}\n"
        f"taskId: {task_id}\n"
        f"dispatchId: {dispatch_s}\n"
        "When finished, send exactly one worker_done (or ask if blocked):\n"
        f"  {worker_done}\n"
        f"Blocked:\n  {ask_line}\n"
    )


def resolve_worker_member(
    state: dict[str, Any], worker_ref: str
) -> dict[str, Any]:
    """Resolve --worker agentId or handle to a worker member dict."""
    ref = (worker_ref or "").strip()
    if not ref:
        raise TeamError("worker ref required")
    members = list(state.get("members") or [])
    workers = [m for m in members if m.get("role") == "worker"]
    for m in workers:
        if str(m.get("agentId") or "") == ref or str(m.get("handle") or "") == ref:
            return m
        if str(m.get("title") or "") == ref:
            return m
    known = ", ".join(
        f"{m.get('agentId')}({m.get('handle') or 'no-handle'})" for m in workers
    ) or "(none)"
    raise TeamError(f"unknown worker '{ref}'. Roster: {known}")


def pid_alive(pid: int) -> bool:
    """True if pid exists and is not a zombie."""
    if pid <= 0:
        return False
    # Prefer /proc so zombies count as dead (kill(0) still succeeds on zombies).
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        state = stat.split(")", 1)[1].lstrip().split(" ", 1)[0]
        return state != "Z"
    except FileNotFoundError:
        return False
    except OSError:
        pass
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _signal_pid(pid: int, sig: int) -> None:
    """Signal a detached watch process; prefer process group (start_new_session)."""
    try:
        os.killpg(pid, sig)
        return
    except ProcessLookupError:
        pass
    except PermissionError:
        pass
    os.kill(pid, sig)


def stop_watch_process(state: dict[str, Any] | None) -> bool:
    """SIGTERM (then SIGKILL) the background watch pid recorded in state. Returns True if a live pid was targeted."""
    if not state:
        return False
    raw = state.get("watchPid")
    if raw is None or raw == "":
        return False
    try:
        pid = int(raw)
    except (TypeError, ValueError):
        state["watchPid"] = None
        return False
    if not pid_alive(pid):
        state["watchPid"] = None
        state["watchStoppedAt"] = utc_now()
        return False
    try:
        _signal_pid(pid, signal.SIGTERM)
    except ProcessLookupError:
        state["watchPid"] = None
        state["watchStoppedAt"] = utc_now()
        return False
    for _ in range(50):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    else:
        try:
            _signal_pid(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        for _ in range(20):
            if not pid_alive(pid):
                break
            time.sleep(0.05)
    state["watchPid"] = None
    state["watchStoppedAt"] = utc_now()
    return True


def start_background_watch(
    worktree_path: Path,
    *,
    interval: int = DEFAULT_WATCH_INTERVAL,
    stale_minutes: float = DEFAULT_WATCH_STALE_MINUTES,
    idle_check: bool = True,
) -> dict[str, Any]:
    """Detach `orca-team watch` in the worktree; log to `.orca/ai-team-watch.log`.

    Child opens its own log via ``--log-file``; parent keeps stdout/stderr as
    DEVNULL so start never looks blocked on the watchdog.
    """
    script = Path(__file__).resolve()
    log_path = watch_log_path_for(worktree_path)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    interval = max(15, int(interval))
    cmd = [
        sys.executable,
        "-u",
        str(script),
        "watch",
        "--interval",
        str(interval),
        "--stale-minutes",
        str(stale_minutes),
        "--log-file",
        str(log_path),
    ]
    if idle_check:
        cmd.append("--idle-check")

    env = os.environ.copy()
    env["PYTHONUNBUFFERED"] = "1"

    try:
        with open(log_path, "a", encoding="utf-8") as log_fh:
            log_fh.write(f"\n--- spawning watch {utc_now()} ---\n")
            log_fh.write(f"cmd: {' '.join(cmd)}\n")
    except OSError:
        pass

    proc = subprocess.Popen(
        cmd,
        cwd=str(worktree_path),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
        env=env,
    )
    # Confirm the detached process actually stayed up briefly.
    time.sleep(0.4)
    alive = pid_alive(proc.pid)
    try:
        with open(log_path, "a", encoding="utf-8") as log_fh:
            log_fh.write(
                f"--- watch pid {proc.pid} ({'alive' if alive else 'EXITED EARLY'}) ---\n"
            )
    except OSError:
        pass
    if not alive:
        raise OSError(f"background watch pid {proc.pid} exited immediately; see {log_path}")
    return {
        "pid": proc.pid,
        "log": str(log_path),
        "interval": interval,
        "staleMinutes": float(stale_minutes),
        "idleCheck": bool(idle_check),
        "cmd": cmd,
    }


def team_still_running(worktree_path: Path, run_id: str) -> bool:
    state = load_state(worktree_path)
    if not state or state.get("status") != "running":
        return False
    if run_id and str(state.get("runId") or "") != run_id:
        return False
    return True


def load_role_templates() -> dict[str, str]:
    if not ROLE_PROMPTS_PATH.is_file():
        raise TeamError(f"missing role prompts at {ROLE_PROMPTS_PATH}")
    text = ROLE_PROMPTS_PATH.read_text()
    sections: dict[str, list[str]] = {"orchestrator": [], "worker": []}
    current: str | None = None
    for line in text.splitlines():
        if line.strip().lower() == "## orchestrator":
            current = "orchestrator"
            continue
        if line.strip().lower() == "## worker":
            current = "worker"
            continue
        if current:
            sections[current].append(line)
    out = {k: "\n".join(v).strip() for k, v in sections.items()}
    if not out["orchestrator"] or not out["worker"]:
        raise TeamError("role-prompts.md missing ## Orchestrator / ## Worker sections")
    return out


def render(template: str, mapping: dict[str, str]) -> str:
    out = template
    for key, value in mapping.items():
        out = out.replace("{{" + key + "}}", value)
    return out


def create_terminal(
    orca: str,
    *,
    title: str,
    command: str,
    worktree_selector: str,
    focus: bool = False,
) -> dict[str, Any]:
    """Create a terminal.

    Note: Orca's ``terminal create --focus`` can time out waiting for a handle
    on some hosts. Prefer create-without-focus, then ``terminal switch``.
    """
    base_args = [
        "terminal",
        "create",
        "--worktree",
        worktree_selector,
        "--title",
        title,
        "--command",
        command,
    ]
    # Never pass --focus on create — it races and returns
    # runtime_error: Timed out waiting for terminal handle after creation.
    # Auto-open is done later via terminal_switch.
    _ = focus  # retained for API compatibility; open happens via switch
    payload = orca_json(orca, base_args, check=False)
    if not payload.get("ok"):
        err = payload.get("error") or {}
        code = err.get("code")
        msg = err.get("message", "")
        # One retry without any UI focus race.
        if code == "runtime_error" and "Timed out waiting for terminal handle" in str(msg):
            eprint("  warning: terminal create timed out; retrying once...")
            time.sleep(1.0)
            payload = orca_json(orca, base_args, check=False)
        if not payload.get("ok"):
            err = payload.get("error") or {}
            raise TeamError(f"{err.get('code', 'error')}: {err.get('message', payload)}")
    term = unwrap(payload).get("terminal") or unwrap(payload)
    if not term.get("handle"):
        raise TeamError(f"terminal create returned no handle: {json.dumps(payload)[:500]}")
    return term


def split_terminal(
    orca: str,
    *,
    from_handle: str,
    command: str,
    direction: str,
) -> dict[str, Any]:
    """Open a new pane in the same tab as from_handle."""
    payload = orca_json(
        orca,
        [
            "terminal",
            "split",
            "--terminal",
            from_handle,
            "--direction",
            direction,
            "--command",
            command,
        ],
    )
    split = unwrap(payload).get("split") or unwrap(payload)
    handle = split.get("handle")
    if not handle:
        raise TeamError(f"terminal split returned no handle: {json.dumps(payload)[:500]}")
    # Normalize to the same shape as create_terminal's terminal object.
    return {
        "handle": handle,
        "tabId": split.get("tabId"),
        "paneKey": split.get("paneKey") or split.get("leafId"),
        "leafId": split.get("leafId"),
        "paneRuntimeId": split.get("paneRuntimeId"),
    }


def wait_tui_idle(orca: str, handle: str, timeout_ms: int = IDLE_TIMEOUT_MS) -> bool:
    payload = orca_json(
        orca,
        [
            "terminal",
            "wait",
            "--terminal",
            handle,
            "--for",
            "tui-idle",
            "--timeout-ms",
            str(timeout_ms),
        ],
        check=False,
    )
    if payload.get("ok"):
        return True
    err = (payload.get("error") or {}).get("code")
    if err == "timeout":
        eprint(f"warning: tui-idle timeout for {handle}; continuing")
        return False
    raise TeamError(f"terminal wait failed for {handle}: {payload.get('error')}")


def _tail_lines_to_text(tail: Any) -> str:
    if isinstance(tail, list):
        parts: list[str] = []
        for row in tail:
            if isinstance(row, str):
                parts.append(row)
            elif isinstance(row, dict):
                parts.append(str(row.get("text") or row.get("line") or row.get("content") or ""))
            else:
                parts.append(str(row))
        return "\n".join(parts)
    if isinstance(tail, str):
        return tail
    return str(tail or "")


def terminal_read_tail(orca: str, handle: str, *, screen: bool = True) -> str:
    """Read terminal output. Prefer --screen so TUI dialogs (trust prompts) are visible."""
    args = ["terminal", "read", "--terminal", handle]
    if screen:
        args.append("--screen")
    payload = orca_json(orca, args, check=False)
    if not payload.get("ok"):
        if screen:
            # Fallback to stream history if screen unavailable.
            return terminal_read_tail(orca, handle, screen=False)
        return ""
    term = unwrap(payload).get("terminal") or unwrap(payload)
    text = _tail_lines_to_text(term.get("tail") or [])
    if screen and not text.strip():
        # Empty screen frame — try stream history.
        return terminal_read_tail(orca, handle, screen=False)
    return text


def ensure_claude_project_trust(worktree_path: Path) -> None:
    """Pre-accept Claude's workspace trust dialog for this path."""
    cfg_path = Path.home() / ".claude.json"
    if not cfg_path.is_file():
        return
    try:
        data = json.loads(cfg_path.read_text())
    except json.JSONDecodeError:
        return
    projects = data.setdefault("projects", {})
    key = str(worktree_path)
    entry = projects.get(key) or {}
    if entry.get("hasTrustDialogAccepted"):
        return
    entry = {
        **entry,
        "allowedTools": entry.get("allowedTools", []),
        "mcpContextUris": entry.get("mcpContextUris", []),
        "mcpServers": entry.get("mcpServers", {}),
        "enabledMcpjsonServers": entry.get("enabledMcpjsonServers", []),
        "disabledMcpjsonServers": entry.get("disabledMcpjsonServers", []),
        "hasTrustDialogAccepted": True,
    }
    projects[key] = entry
    data["projects"] = projects
    cfg_path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"  noted Claude trust for {key}")


def wait_agent_ready(
    orca: str,
    handle: str,
    *,
    agent_id: str,
    timeout_ms: int = 180_000,
    poll_ms: int = 1500,
) -> bool:
    """Poll terminal output until agent looks ready for input (past banner/onboarding)."""
    markers = AGENT_READY_MARKERS.get(agent_id) or AGENT_READY_MARKERS.get(
        agent_id.split("-")[0], ()
    )
    # Always wait for tui-idle first, then confirm ready markers when we have them.
    wait_tui_idle(orca, handle, timeout_ms=min(timeout_ms, 90_000))
    if not markers:
        return True
    deadline = time.time() + (timeout_ms / 1000.0)
    while time.time() < deadline:
        text = terminal_read_tail(orca, handle).lower()
        # Still booting / onboarding — keep waiting.
        if any(
            bad in text
            for bad in (
                "learning your coding taste",
                "taste onboarding",
                "do you trust the contents",
                "quick safety check",
            )
        ) and not any(m.lower() in text for m in markers):
            time.sleep(poll_ms / 1000.0)
            continue
        if any(m.lower() in text for m in markers):
            return True
        time.sleep(poll_ms / 1000.0)
    eprint(f"warning: ready markers not seen for {agent_id} ({handle}) before timeout")
    return False


def dismiss_startup_prompts(orca: str, handle: str, *, agent_id: str) -> None:
    """Accept common first-run trust dialogs so role prompts can be delivered."""
    wait_tui_idle(orca, handle, timeout_ms=60_000)
    for _ in range(4):
        text = terminal_read_tail(orca, handle).lower()
        if not text:
            time.sleep(0.5)
            continue
        needs_yes = (
            "do you trust the contents of this directory" in text
            or "is this a project you created or one you trust" in text
            or "workspace trust" in text
            or ("trust" in text and "yes, proceed" in text)
        )
        if needs_yes:
            # Grok (and similar) show a numbered menu: "1. Yes, proceed" / "2. No, exit".
            # Sending "y" leaves them stuck on that dialog — prefer "1" when numbered.
            numbered = "1. yes" in text or "1. yes, proceed" in text or "❯ 1." in text
            if numbered or "yes, proceed" in text:
                answer = "1"
            elif is_claude_agent(agent_id) and "quick safety check" in text:
                answer = "y"
            elif agent_id in {"grok", "codex", "opencode", "pi", "command-code"}:
                # Fallback for y/n style prompts.
                answer = "1" if "proceed" in text else "y"
            else:
                answer = "1"
            print(f"  accepting trust prompt on {handle} ({agent_id}) with {answer!r}")
            orca_json(
                orca,
                [
                    "terminal",
                    "send",
                    "--terminal",
                    handle,
                    "--text",
                    answer,
                    "--enter",
                ],
                check=False,
            )
            time.sleep(1.0)
            wait_tui_idle(orca, handle, timeout_ms=60_000)
            continue
        # Ready-ish agent prompt markers
        if any(
            marker in text
            for marker in (
                "❯",
                "│ ❯",
                "bypass permissions",
                "always-approve",
                "grok 4",
                "claude code",
                "? for shortcuts",
            )
        ):
            return
        time.sleep(0.8)


def terminal_send(orca: str, handle: str, text: str, *, retries: int = 3) -> None:
    last_err: str | None = None
    for attempt in range(1, retries + 1):
        wait_tui_idle(orca, handle, timeout_ms=90_000)
        payload = orca_json(
            orca,
            [
                "terminal",
                "send",
                "--terminal",
                handle,
                "--text",
                text,
                "--enter",
            ],
            check=False,
        )
        if payload.get("ok"):
            return
        err = payload.get("error") or {}
        last_err = f"{err.get('code')}: {err.get('message')}"
        if err.get("code") in {"agent_prompt_stalled", "timeout", "terminal_busy"}:
            eprint(f"  retry send ({attempt}/{retries}) on {handle}: {last_err}")
            time.sleep(1.5 * attempt)
            continue
        raise TeamError(f"terminal send failed for {handle}: {last_err}")
    raise TeamError(f"terminal send failed for {handle} after retries: {last_err}")


def terminal_rename(orca: str, handle: str, title: str) -> None:
    orca_json(
        orca,
        ["terminal", "rename", "--terminal", handle, "--title", title],
        check=False,
    )


def terminal_switch(orca: str, handle: str) -> bool:
    """Reveal/focus a terminal tab in the Orca UI. Returns True on success."""
    payload = orca_json(
        orca,
        ["terminal", "switch", "--terminal", handle],
        check=False,
    )
    if payload.get("ok"):
        return True
    err = payload.get("error") or {}
    eprint(
        f"warning: could not auto-open tab for {handle}: "
        f"{err.get('code')} {err.get('message')}"
    )
    return False


def ensure_orca_app(orca: str) -> None:
    """Make sure the Orca app/runtime is up (best-effort window reveal)."""
    orca_json(orca, ["open"], check=False)


def raise_orca_desktop_window() -> bool:
    """Best-effort: bring the Orca desktop window to the foreground."""
    # Inherit display/session vars from the running Orca app if our shell lacks them.
    status_pid = None
    try:
        # Prefer the live app pid from a prior status call path via /proc scan.
        for proc_dir in Path("/proc").iterdir():
            if not proc_dir.name.isdigit():
                continue
            try:
                cmdline = (proc_dir / "cmdline").read_bytes()
            except OSError:
                continue
            if b"/usr/lib/orca-ide/app.asar" in cmdline and b"type=renderer" not in cmdline and b"daemon-entry" not in cmdline:
                # main electron process
                if b"computer-sidecar" in cmdline or b"parcel-watcher" in cmdline or b"session-scanner" in cmdline:
                    continue
                if cmdline.startswith(b"/usr/lib/electron") and b"app.asar\x00" in cmdline:
                    status_pid = int(proc_dir.name)
                    break
    except OSError:
        status_pid = None

    env = os.environ.copy()
    if status_pid:
        try:
            raw = Path(f"/proc/{status_pid}/environ").read_bytes().split(b"\0")
            for item in raw:
                if b"=" not in item:
                    continue
                key, _, val = item.partition(b"=")
                key_s = key.decode(errors="ignore")
                if key_s in {
                    "DISPLAY",
                    "WAYLAND_DISPLAY",
                    "XDG_RUNTIME_DIR",
                    "HYPRLAND_INSTANCE_SIGNATURE",
                    "DBUS_SESSION_BUS_ADDRESS",
                } and key_s not in env:
                    env[key_s] = val.decode(errors="ignore")
        except OSError:
            pass

    # Discover Hyprland instance if still missing.
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        hypr_root = Path(runtime) / "hypr"
        if hypr_root.is_dir():
            for child in sorted(hypr_root.iterdir()):
                if child.is_dir():
                    env["HYPRLAND_INSTANCE_SIGNATURE"] = child.name
                    break

    # Hyprland focus by class/title.
    if shutil.which("hyprctl"):
        try:
            proc = subprocess.run(
                ["hyprctl", "clients", "-j"],
                capture_output=True,
                text=True,
                env=env,
                check=False,
            )
            clients = json.loads(proc.stdout or "[]")
            target = None
            for client in clients:
                cls = str(client.get("class") or "")
                title = str(client.get("title") or "")
                pid = client.get("pid")
                if status_pid and pid == status_pid:
                    target = client
                    break
                if "orca" in cls.lower() or "orca" in title.lower():
                    target = client
            if target and target.get("address"):
                subprocess.run(
                    ["hyprctl", "dispatch", "focuswindow", f"address:{target['address']}"],
                    capture_output=True,
                    text=True,
                    env=env,
                    check=False,
                )
                return True
        except (json.JSONDecodeError, OSError):
            pass

    # X11 fallback.
    if shutil.which("xdotool") and env.get("DISPLAY"):
        try:
            if status_pid:
                proc = subprocess.run(
                    ["xdotool", "search", "--pid", str(status_pid)],
                    capture_output=True,
                    text=True,
                    env=env,
                    check=False,
                )
                wid = (proc.stdout or "").strip().splitlines()
                if wid:
                    subprocess.run(
                        ["xdotool", "windowactivate", "--sync", wid[0]],
                        capture_output=True,
                        text=True,
                        env=env,
                        check=False,
                    )
                    return True
            proc = subprocess.run(
                ["xdotool", "search", "--name", "Orca"],
                capture_output=True,
                text=True,
                env=env,
                check=False,
            )
            wid = (proc.stdout or "").strip().splitlines()
            if wid:
                subprocess.run(
                    ["xdotool", "windowactivate", "--sync", wid[0]],
                    capture_output=True,
                    text=True,
                    env=env,
                    check=False,
                )
                return True
        except OSError:
            pass
    return False


def next_split_direction(split_direction: str, opened_index: int) -> str:
    """Alternate split axes so panes tile instead of stacking on one axis."""
    if opened_index <= 0:
        return split_direction
    if split_direction == "horizontal":
        return "vertical" if opened_index % 2 == 1 else "horizontal"
    return "horizontal" if opened_index % 2 == 1 else "vertical"


def resolve_layout(args: argparse.Namespace) -> str:
    if getattr(args, "same_tab", False):
        return "split"
    if getattr(args, "dual_tab", False):
        return "dual"
    return str(getattr(args, "layout", DEFAULT_LAYOUT) or DEFAULT_LAYOUT)


def tab_titles_for_layout(layout: str, orchestrator: str) -> tuple[str, str | None]:
    """Return (focus_tab_title, workers_tab_title_or_none)."""
    if layout == "split":
        return "ai-team", None
    if layout == "dual":
        return ORCH_TAB_TITLE, WORKERS_TAB_TITLE
    return f"orchestrator:{orchestrator}", None


def print_remote_open_help(
    *,
    worktree_path: Path,
    tab_title: str,
    workers_tab_title: str | None = None,
) -> None:
    """Explain how to find the team when viewing via Orca remote from another machine."""
    print("  remote viewer:")
    print(f"    1. On the remote Orca client, open worktree card: {worktree_path.name}")
    print(f"       path: {worktree_path}")
    print(f"    2. Click tab titled exactly: {tab_title}")
    if workers_tab_title:
        print(f"       (workers are in a second tab titled: {workers_tab_title})")
        print("    3. Orchestrator tab is alone; workers tab has split panes")
    else:
        print("    3. You should see the team panes in that tab")
    print("    note: `terminal switch` focuses the HOST Orca UI; remote viewers must")
    print("    select the worktree + tab manually (focus does not mirror over remote).")


def reveal_team_tab(
    orca: str,
    handle: str,
    *,
    tab_title: str = "ai-team",
    worktree_path: Path | None = None,
) -> bool:
    """Ensure Orca is up, keep a stable tab title, switch to it, raise the window."""
    ensure_orca_app(orca)
    # Agents overwrite tab titles with their own TUI titles — re-stamp before switch.
    terminal_rename(orca, handle, tab_title)
    time.sleep(0.2)
    ok = terminal_switch(orca, handle)
    raised = raise_orca_desktop_window()
    # Second switch after raise helps when the window was on another workspace.
    time.sleep(0.2)
    ok = terminal_switch(orca, handle) or ok
    terminal_rename(orca, handle, tab_title)
    if ok:
        print(f"  focused HOST tab titled exactly: {tab_title}")
        if raised:
            print("  raised HOST Orca desktop window")
        else:
            print("  tip: on the host machine, click the Orca window if it stayed in background")
        print(f"  tip: ignore leftover single tabs named 'ai-team:claude' — use '{tab_title}'")
    if worktree_path is not None:
        print_remote_open_help(worktree_path=worktree_path, tab_title=tab_title)
    return ok


def cmd_doctor(args: argparse.Namespace) -> int:
    problems: list[str] = []
    print("orca-team doctor")
    try:
        orca = resolve_orca()
        print(f"  orca cli: {orca}")
    except TeamError as exc:
        print(f"  orca cli: FAIL ({exc})")
        return 1

    status = orca_json(orca, ["status"], check=False)
    if not status.get("ok"):
        problems.append(f"status not ok: {status.get('error')}")
        print("  runtime: FAIL")
    else:
        result = unwrap(status)
        runtime = result.get("runtime") or {}
        app = result.get("app") or {}
        print(
            f"  runtime: {runtime.get('state')} reachable={runtime.get('reachable')} "
            f"app_running={app.get('running')} version={runtime.get('appVersion')}"
        )
        if runtime.get("state") != "ready" or not runtime.get("reachable"):
            problems.append("Orca runtime is not ready")
        caps = runtime.get("capabilities") or []
        orch_caps = [c for c in caps if "orchestration" in c]
        print(f"  orchestration caps: {len(orch_caps)} ({', '.join(orch_caps[:4])}{'...' if len(orch_caps) > 4 else ''})")
        if not orch_caps:
            problems.append(
                "No orchestration capabilities reported. Enable Settings → Experimental → orchestration."
            )

    cwd = Path.cwd()
    try:
        wt = find_worktree(orca, cwd)
        print(f"  worktree: {wt.get('displayName')} @ {wt.get('path')}")
    except TeamError as exc:
        print(f"  worktree: FAIL ({exc})")
        problems.append(str(exc))

    print("  agents:")
    printed: set[str] = set()
    show_ids = [DEFAULT_ORCHESTRATOR, *DEFAULT_WORKERS]
    for agent_id in sorted(AGENT_LAUNCH):
        if agent_id in {"claude", "opus", "sonnet"}:
            continue
        if agent_id not in show_ids:
            show_ids.append(agent_id)
    for agent_id in show_ids:
        if agent_id in printed:
            continue
        printed.add(agent_id)
        binary = binary_for(agent_id)
        path = shutil.which(binary)
        launch = launch_command(agent_id)
        if path:
            print(f"    {agent_id}: OK ({path}) → `{launch}`")
        else:
            mark = "WARN" if agent_id not in (DEFAULT_ORCHESTRATOR, *DEFAULT_WORKERS) else "FAIL"
            print(f"    {agent_id}: {mark} (binary '{binary}' not on PATH)")
            if agent_id in (DEFAULT_ORCHESTRATOR, *DEFAULT_WORKERS):
                problems.append(f"missing default agent binary: {binary}")

    # Probe orchestration binding requirement with a no-op list.
    probe = orca_json(orca, ["orchestration", "run-list"], check=False)
    if not probe.get("ok"):
        err = probe.get("error") or {}
        print(f"  orchestration run-list: FAIL ({err.get('code')}: {err.get('message')})")
        problems.append(
            "orchestration commands failed — enable Experimental orchestration in Orca settings"
        )
    else:
        print("  orchestration run-list: OK")

    if problems:
        print("\nProblems:")
        for item in problems:
            print(f"  - {item}")
        return 1
    print("\nAll checks passed.")
    return 0


def cmd_start(args: argparse.Namespace) -> int:
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    worktree_id = wt.get("id") or f"path:{worktree_path}"
    selector = f"path:{worktree_path}"

    existing = load_state(worktree_path)
    if existing and existing.get("status") == "running" and not args.force:
        raise TeamError(
            f"team already running in {worktree_path} (run {existing.get('runId')}).\n"
            "Use `orca-team status`, `orca-team stop`, or pass --force."
        )
    if existing:
        # Drop any leftover watchdog from a previous/forced start.
        old_watch_pid = existing.get("watchPid")
        if stop_watch_process(existing):
            print(f"  stopped previous watch pid {old_watch_pid}")
            save_state(worktree_path, existing)

    orchestrator, workers, models_by_agent, config_present = resolve_start_roster(args)
    if orchestrator in workers:
        workers = [w for w in workers if w != orchestrator]
    objective = args.objective or "Coordinate the AI team on the current worktree objective"
    enable_watch = bool(getattr(args, "watch", True))
    ignore_quota = bool(getattr(args, "ignore_quota", False))
    min_remaining = float(
        getattr(args, "min_remaining", DEFAULT_MIN_REMAINING_PERCENT)
    )
    save_defaults = bool(getattr(args, "save_defaults", False))

    # Ensure binaries exist for requested agents.
    for agent_id in [orchestrator, *workers]:
        binary = binary_for(agent_id)
        if not shutil.which(binary):
            raise TeamError(f"agent binary not found on PATH: {binary} (id={agent_id})")

    templates = load_role_templates()
    members: list[dict[str, Any]] = []

    layout = resolve_layout(args)
    split_direction = args.split_direction
    tab_title, workers_tab_title = tab_titles_for_layout(layout, orchestrator)

    orch_model = models_by_agent.get(orchestrator)
    orch_launch = launch_command(orchestrator, model=orch_model)
    print(f"Starting AI team in {worktree_path}")
    print(f"  config: {config_path()}" + (" (loaded)" if config_present else " (missing — built-in defaults)"))
    if not config_present:
        print(
            "  tip: set lasting defaults with: "
            "orca-team config init && orca-team config set --orchestrator … --workers …"
        )
    print(f"  orchestrator: {orchestrator} → `{orch_launch}`")
    print(f"  workers: {', '.join(workers) if workers else '(none)'}")
    for wid in workers:
        wm = models_by_agent.get(wid)
        if wm:
            print(f"    model {wid}: {wm}")
    layout_note = ""
    if layout in {"split", "dual"}:
        layout_note = f" ({split_direction})"
    if layout == "dual":
        layout_note += f" — tabs '{tab_title}' + '{workers_tab_title}'"
    print(f"  layout: {layout}{layout_note}")
    print(f"  watch: {'on' if enable_watch else 'off'}")
    print(
        f"  quota: {'ignored' if ignore_quota else f'skip workers <{min_remaining:.0f}% remaining'}"
    )
    print(f"  objective: {objective}")

    # Probe usage before opening panes — skip exhausted workers (e.g. grok at 4%).
    quota_deferred: set[str] = set()
    usage_rows = usage_report([orchestrator, *workers])
    usage_by_id = {str(r.get("agentId")): r for r in usage_rows}
    print("  usage:")
    for row in usage_rows:
        aid = str(row.get("agentId"))
        flag = ""
        if not ignore_quota and aid != orchestrator and agent_below_quota(
            row, min_remaining=min_remaining
        ):
            quota_deferred.add(aid)
            flag = " → DEFER (low quota)"
        status = "ok" if row.get("ok") else "fail"
        rem = row.get("remainingPercent")
        rem_s = f"{float(rem):.0f}% left" if rem is not None else "unknown"
        print(f"    - {aid}: {status} {rem_s} — {row.get('detail') or ''}{flag}")
    if quota_deferred:
        print(
            f"  deferring low-quota workers (no pane): {', '.join(sorted(quota_deferred))}"
        )

    if is_claude_agent(orchestrator) or any(is_claude_agent(w) for w in workers):
        ensure_claude_project_trust(worktree_path)

    # 1) Orchestrator terminal (always its own tab; dual/split/tabs differ for workers)
    # Keep a stable short title. Agent TUIs overwrite longer titles and confuse auto-open.
    open_tab = not getattr(args, "no_open", False)
    orch_term = create_terminal(
        orca,
        title=tab_title,
        command=orch_launch,
        worktree_selector=selector,
        focus=False,
    )
    orch_handle = orch_term["handle"]
    orch_tab_id = orch_term.get("tabId")
    print(f"  created orchestrator terminal {orch_handle} (tab '{tab_title}')")
    dismiss_startup_prompts(orca, orch_handle, agent_id=orchestrator)
    terminal_rename(orca, orch_handle, tab_title)
    members.append(
        {
            "role": "orchestrator",
            "agentId": orchestrator,
            "title": f"orchestrator:{orchestrator}",
            "handle": orch_handle,
            "launchCommand": orch_launch,
            "model": orch_model,
            "tabId": orch_tab_id,
            "paneKey": orch_term.get("paneKey"),
        }
    )

    # 2) Bind run to orchestrator
    run_payload = orca_json(
        orca,
        [
            "orchestration",
            "run-create",
            "--objective",
            objective,
            "--from",
            orch_handle,
        ],
    )
    run = unwrap(run_payload).get("run") or unwrap(run_payload)
    run_id = run["id"]
    print(f"  run: {run_id}")

    # 3) Worker terminals.
    #   split  → panes in the orchestrator tab
    #   dual   → one shared workers tab (first worker creates it; rest split in)
    #   tabs   → one tab per worker
    # Deferred agents (e.g. command-code) are roster-only until worker-start --agent.
    split_anchor = orch_handle
    workers_tab_id: str | None = None
    workers_tab_handle: str | None = None
    opened_index = 0
    for agent_id in workers:
        agent_model = models_by_agent.get(agent_id)
        agent_launch = launch_command(agent_id, model=agent_model)
        if agent_id in DEFERRED_AGENTS or agent_id in quota_deferred:
            reason = (
                "low quota"
                if agent_id in quota_deferred
                else "deferred agent (open via worker-start)"
            )
            rem = (usage_by_id.get(agent_id) or {}).get("remainingPercent")
            rem_note = f", ~{float(rem):.0f}% remaining" if rem is not None else ""
            print(
                f"  deferred worker:{agent_id} (no pane) — {reason}{rem_note}"
            )
            members.append(
                {
                    "role": "worker",
                    "agentId": agent_id,
                    "title": f"worker:{agent_id}",
                    "handle": None,
                    "deferred": True,
                    "deferredReason": "quota_low" if agent_id in quota_deferred else "agent_policy",
                    "usage": usage_by_id.get(agent_id),
                    "launchCommand": agent_launch,
                    "model": agent_model,
                    "tabId": workers_tab_id if layout == "dual" else orch_tab_id,
                    "paneKey": None,
                    "spawnHint": (
                        f"orca orchestration worker-start --task <task_id> "
                        f"--worktree current --agent {agent_id} --json"
                        if agent_id not in quota_deferred
                        else (
                            f"SKIP until quota recovers "
                            f"(remaining {rem}% < {min_remaining:.0f}%)"
                            if rem is not None
                            else "SKIP until quota recovers"
                        )
                    ),
                }
            )
            continue

        if layout == "split":
            direction = next_split_direction(split_direction, opened_index)
            term = split_terminal(
                orca,
                from_handle=split_anchor,
                command=agent_launch,
                direction=direction,
            )
            handle = term["handle"]
            print(
                f"  split worker:{agent_id} pane {handle} "
                f"(orch tab, {direction} from {split_anchor})"
            )
            split_anchor = handle
        elif layout == "dual":
            if workers_tab_handle is None:
                assert workers_tab_title is not None
                term = create_terminal(
                    orca,
                    title=workers_tab_title,
                    command=agent_launch,
                    worktree_selector=selector,
                )
                handle = term["handle"]
                workers_tab_handle = handle
                workers_tab_id = term.get("tabId")
                terminal_rename(orca, handle, workers_tab_title)
                print(
                    f"  created workers tab '{workers_tab_title}' "
                    f"with worker:{agent_id} ({handle})"
                )
            else:
                direction = next_split_direction(split_direction, opened_index)
                term = split_terminal(
                    orca,
                    from_handle=split_anchor,
                    command=agent_launch,
                    direction=direction,
                )
                handle = term["handle"]
                print(
                    f"  split worker:{agent_id} pane {handle} "
                    f"(workers tab, {direction})"
                )
            split_anchor = handle
        else:
            term = create_terminal(
                orca,
                title=f"worker:{agent_id}",
                command=agent_launch,
                worktree_selector=selector,
            )
            handle = term["handle"]
            print(f"  created worker:{agent_id} terminal {handle}")
            terminal_rename(orca, handle, f"worker:{agent_id}")

        dismiss_startup_prompts(orca, handle, agent_id=agent_id)
        wait_agent_ready(orca, handle, agent_id=agent_id)
        members.append(
            {
                "role": "worker",
                "agentId": agent_id,
                "title": f"worker:{agent_id}",
                "handle": handle,
                "deferred": False,
                "launchCommand": agent_launch,
                "model": agent_model,
                "tabId": term.get("tabId")
                or (workers_tab_id if layout == "dual" else orch_tab_id),
                "paneKey": term.get("paneKey"),
            }
        )
        opened_index += 1

    roster_lines = []
    for member in members:
        if member["role"] == "worker":
            roster_lines.append(
                f"- {member['agentId']}: handle `{member['handle']}` title `{member['title']}`"
            )
    roster = "\n".join(roster_lines) if roster_lines else "- (no workers)"

    load_handoff = not getattr(args, "no_handoff", False)
    prior_handoff = None
    if load_handoff:
        prior_handoff = load_handoff_text(worktree_path)
        if prior_handoff:
            print(f"  loaded prior handoff: {handoff_path_for(worktree_path)}")
        else:
            print(f"  no prior {HANDOFF_FILENAME} (fresh context)")
    else:
        print("  handoff load: skipped (--no-handoff)")
    prior_handoff_block = (
        prior_handoff
        if prior_handoff
        else f"(none — no `{HANDOFF_FILENAME}` in this worktree yet)"
    )

    # 4) Inject role prompts (skip deferred workers — no pane yet)
    for member in members:
        if member.get("deferred") or not member.get("handle"):
            print(f"  skip role inject → {member.get('title')} (deferred)")
            continue
        if member["role"] == "orchestrator":
            prompt = render(
                templates["orchestrator"],
                {
                    "RUN_ID": run_id,
                    "OBJECTIVE": objective,
                    "WORKTREE_PATH": str(worktree_path),
                    "ORCHESTRATOR_HANDLE": orch_handle,
                    "ROSTER": roster,
                    "PRIOR_HANDOFF": prior_handoff_block,
                },
            )
        else:
            prompt = render(
                templates["worker"],
                {
                    "RUN_ID": run_id,
                    "OBJECTIVE": objective,
                    "WORKTREE_PATH": str(worktree_path),
                    "AGENT_ID": member["agentId"],
                    "WORKER_HANDLE": member["handle"],
                    "ORCHESTRATOR_HANDLE": orch_handle,
                },
            )
        print(f"  injecting role prompt → {member['title']}")
        wait_agent_ready(orca, member["handle"], agent_id=str(member.get("agentId") or ""))
        terminal_send(orca, member["handle"], prompt)
        if member.get("role") == "worker":
            mark_role_injected(member, str(member["handle"]))
        # Brief pause so TUIs don't race successive injects on the same host.
        time.sleep(0.4)

    # Optional supervise mode: create one umbrella task per worker.
    tasks: list[dict[str, Any]] = []
    if args.mode == "supervise":
        task_spec = args.task or objective
        for member in members:
            if member["role"] != "worker":
                continue
            if member.get("deferred") or not member.get("handle"):
                # Deferred agents: create task only; orchestrator/worker-start opens them.
                spec = f"[{member['agentId']}] {task_spec}"
                task_payload = orca_json(
                    orca,
                    [
                        "orchestration",
                        "task-create",
                        "--spec",
                        spec,
                        "--from",
                        orch_handle,
                    ],
                )
                task = unwrap(task_payload).get("task") or unwrap(task_payload)
                task_id = task.get("id") or task.get("taskId")
                start_payload = orca_json(
                    orca,
                    [
                        "orchestration",
                        "worker-start",
                        "--task",
                        str(task_id),
                        "--worktree",
                        "current",
                        "--agent",
                        str(member["agentId"]),
                        "--from",
                        orch_handle,
                        "--run",
                        run_id,
                    ],
                    check=False,
                )
                tasks.append(
                    {
                        "taskId": task_id,
                        "agentId": member["agentId"],
                        "handle": None,
                        "deferred": True,
                        "workerStartOk": bool(start_payload.get("ok")),
                        "workerStart": unwrap(start_payload)
                        if start_payload.get("ok")
                        else start_payload.get("error"),
                    }
                )
                if start_payload.get("ok"):
                    print(f"  supervised deferred launch → {member['agentId']} task {task_id}")
                else:
                    eprint(
                        f"warning: deferred worker-start failed for {member['agentId']}: "
                        f"{(start_payload.get('error') or {}).get('message')}"
                    )
                continue
            spec = f"[{member['agentId']}] {task_spec}"
            task_payload = orca_json(
                orca,
                [
                    "orchestration",
                    "task-create",
                    "--spec",
                    spec,
                    "--from",
                    orch_handle,
                ],
            )
            task = unwrap(task_payload).get("task") or unwrap(task_payload)
            task_id = task.get("id") or task.get("taskId")
            if not task_id:
                raise TeamError(f"task-create missing id: {json.dumps(task_payload)[:500]}")
            start_payload = orca_json(
                orca,
                [
                    "orchestration",
                    "worker-start",
                    "--task",
                    task_id,
                    "--worktree",
                    "current",
                    "--terminal",
                    member["handle"],
                    "--from",
                    orch_handle,
                    "--run",
                    run_id,
                ],
                check=False,
            )
            tasks.append(
                {
                    "taskId": task_id,
                    "agentId": member["agentId"],
                    "handle": member["handle"],
                    "workerStartOk": bool(start_payload.get("ok")),
                    "workerStart": unwrap(start_payload) if start_payload.get("ok") else start_payload.get("error"),
                }
            )
            if start_payload.get("ok"):
                print(f"  supervised dispatch → {member['agentId']} task {task_id}")
            else:
                eprint(
                    f"warning: worker-start failed for {member['agentId']}: "
                    f"{(start_payload.get('error') or {}).get('message')}"
                )

    state = {
        "version": 1,
        "status": "running",
        "startedAt": utc_now(),
        "mode": args.mode,
        "layout": layout,
        "splitDirection": split_direction if layout in {"split", "dual"} else None,
        "orchTabTitle": tab_title,
        "workersTabTitle": workers_tab_title,
        "workersTabHandle": workers_tab_handle,
        "objective": objective,
        "runId": run_id,
        "worktreeId": worktree_id,
        "worktreePath": str(worktree_path),
        "orcaCli": orca,
        "members": members,
        "tasks": tasks,
        "watchEnabled": enable_watch,
        "watchPid": None,
        "watchLog": None,
        "minRemainingPercent": None if ignore_quota else min_remaining,
        "usageAtStart": usage_rows,
        "quotaDeferred": sorted(quota_deferred),
        "models": {
            aid: model
            for aid, model in models_by_agent.items()
            if isinstance(model, str) and model.strip()
        },
        "userConfigPath": str(config_path()),
        "userConfigLoaded": config_present,
    }
    path = save_state(worktree_path, state)

    if enable_watch:
        try:
            watch_info = start_background_watch(
                worktree_path,
                interval=int(getattr(args, "watch_interval", DEFAULT_WATCH_INTERVAL)),
                stale_minutes=float(
                    getattr(args, "watch_stale_minutes", DEFAULT_WATCH_STALE_MINUTES)
                ),
                idle_check=True,
            )
            state["watchPid"] = watch_info["pid"]
            state["watchLog"] = watch_info["log"]
            state["watchInterval"] = watch_info["interval"]
            state["watchStaleMinutes"] = watch_info["staleMinutes"]
            state["watchStartedAt"] = utc_now()
            path = save_state(worktree_path, state)
        except OSError as exc:
            eprint(f"warning: could not start background watch: {exc}")
            state["watchEnabled"] = False
            state["watchPid"] = None
            save_state(worktree_path, state)

    # Best-effort worktree comment — visible on remote worktree cards.
    try:
        orca_json(
            orca,
            [
                "worktree",
                "set",
                "--worktree",
                selector,
                "--comment",
                (
                    f'ai-team LIVE — orch tab "{tab_title}"'
                    + (f' + workers tab "{workers_tab_title}"' if workers_tab_title else "")
                    + f" ({orchestrator}+{len(workers)}, {layout})"
                ),
            ],
            check=False,
        )
    except TeamError:
        pass

    if open_tab:
        if not reveal_team_tab(
            orca,
            orch_handle,
            tab_title=tab_title,
            worktree_path=worktree_path,
        ):
            print(
                f"  tip: run `orca-team open` or "
                f"`orca terminal switch --terminal {orch_handle} --json`"
            )
            print_remote_open_help(
                worktree_path=worktree_path,
                tab_title=tab_title,
                workers_tab_title=workers_tab_title,
            )

    print("\nTeam ready.")
    print(f"  runId:    {run_id}")
    print(f"  layout:   {layout}")
    print(f"  state:    {path}")
    if state.get("watchPid"):
        rel_log = state.get("watchLog") or str(watch_log_path_for(worktree_path))
        print(f"  watch:    RUNNING pid {state['watchPid']} (background)")
        print(
            f"            every {state.get('watchInterval', DEFAULT_WATCH_INTERVAL)}s, "
            f"stale>{state.get('watchStaleMinutes', DEFAULT_WATCH_STALE_MINUTES)}m, idle-check"
        )
        print(f"            log: {rel_log}")
        print(f"            follow: tail -f {rel_log}")
    elif not enable_watch:
        print("  watch:    off (--no-watch)")
    else:
        print("  watch:    failed to start (see warnings above)")
    if layout == "dual":
        print(f"  next:     tab '{tab_title}' (orchestrator alone)")
        print(f"            tab '{workers_tab_title}' (all workers split)")
    elif layout == "split":
        print(f"  next:     open worktree + tab '{tab_title}' (all agents split)")
    else:
        print(f"  next:     talk to tab orchestrator:{orchestrator}")
    print("  open:     orca-team open   # host focus + remote instructions")
    print("  status:   orca-team status")
    print("  stop:     orca-team stop")

    if save_defaults:
        models_to_save = {
            aid: model
            for aid, model in models_by_agent.items()
            if isinstance(model, str) and model.strip()
        }
        saved = save_user_config(
            {
                "version": 1,
                "orchestrator": orchestrator,
                "workers": workers,
                "models": models_to_save,
            }
        )
        print(f"  saved defaults → {saved}")

    print("\nStart finished — shell is free. Watch keeps running in the background.")
    sys.stdout.flush()
    return 0


def build_role_prompt(
    *,
    templates: dict[str, str],
    member: dict[str, Any],
    run_id: str,
    objective: str,
    worktree_path: Path,
    orch_handle: str,
    roster: str,
    prior_handoff: str | None = None,
) -> str:
    if member.get("role") == "orchestrator":
        handoff = prior_handoff
        if handoff is None:
            handoff = load_handoff_text(worktree_path)
        handoff_block = (
            handoff
            if handoff
            else f"(none — no `{HANDOFF_FILENAME}` in this worktree yet)"
        )
        return render(
            templates["orchestrator"],
            {
                "RUN_ID": run_id,
                "OBJECTIVE": objective,
                "WORKTREE_PATH": str(worktree_path),
                "ORCHESTRATOR_HANDLE": orch_handle,
                "ROSTER": roster,
                "PRIOR_HANDOFF": handoff_block,
            },
        )
    return render(
        templates["worker"],
        {
            "RUN_ID": run_id,
            "OBJECTIVE": objective,
            "WORKTREE_PATH": str(worktree_path),
            "AGENT_ID": str(member.get("agentId") or "worker"),
            "WORKER_HANDLE": str(member.get("handle") or ""),
            "ORCHESTRATOR_HANDLE": orch_handle,
        },
    )


def roster_from_members(members: list[dict[str, Any]]) -> str:
    lines = []
    for member in members:
        if member.get("role") != "worker":
            continue
        agent_id = member.get("agentId")
        if member.get("deferred") or not member.get("handle"):
            reason = member.get("deferredReason") or "deferred"
            hint = member.get("spawnHint") or (
                f"orca orchestration worker-start --task <task_id> "
                f"--worktree current --agent {agent_id} --json"
            )
            if reason == "quota_low":
                lines.append(
                    f"- {agent_id}: DEFERRED (low quota) — do NOT assign/open until usage recovers "
                    f"(`orca-team usage`). Hint: {hint}"
                )
            else:
                lines.append(
                    f"- {agent_id}: DEFERRED (no live pane) — spawn with `{hint}`"
                )
        else:
            lines.append(
                f"- {agent_id}: handle `{member.get('handle')}` title `{member.get('title')}`"
            )
    return "\n".join(lines) if lines else "- (no workers)"


def cmd_usage(args: argparse.Namespace) -> int:
    """Show remaining usage for orchestrator + workers (and optional extra agents)."""
    cwd = Path.cwd()
    agents: list[str] = []
    state = None
    try:
        orca = resolve_orca()
        wt = find_worktree(orca, cwd)
        state = load_state(Path(wt["path"]).resolve())
    except TeamError:
        state = None
    if state and state.get("members"):
        for m in state.get("members") or []:
            aid = m.get("agentId")
            if aid:
                agents.append(str(aid))
    extra = str(getattr(args, "agents", "") or "").strip()
    if extra:
        for part in extra.split(","):
            aid = part.strip()
            if not aid:
                continue
            if aid not in AGENT_LAUNCH:
                raise TeamError(f"unknown agent id '{aid}'")
            agents.append(aid)
    if not agents:
        agents = [DEFAULT_ORCHESTRATOR, *DEFAULT_WORKERS]
    # unique preserve order
    seen: set[str] = set()
    ordered = []
    for a in agents:
        if a not in seen:
            seen.add(a)
            ordered.append(a)
    min_remaining = float(getattr(args, "min_remaining", DEFAULT_MIN_REMAINING_PERCENT))
    rows = usage_report(ordered)
    if getattr(args, "json", False):
        print(json.dumps({"minRemainingPercent": min_remaining, "agents": rows}, indent=2))
        return 0
    print(f"Agent usage (skip assign if remaining < {min_remaining:.0f}%)")
    rc = 0
    for row in rows:
        aid = row.get("agentId")
        rem = row.get("remainingPercent")
        if rem is None:
            mark = "?"
        elif agent_below_quota(row, min_remaining=min_remaining):
            mark = "LOW"
            rc = 1
        else:
            mark = "OK"
        rem_s = f"{float(rem):.0f}% left" if rem is not None else "unknown"
        print(f"  [{mark}] {aid}: {rem_s} — {row.get('detail') or row.get('source')}")
    print("Tip: orchestrator should run this before dispatching / worker-start.")
    return rc


def cmd_open(args: argparse.Namespace) -> int:
    """Focus the running team tab in the Orca UI (and raise the app window)."""
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state:
        raise TeamError("no ai-team state; run orca-team start first")
    orch = next((m for m in state.get("members") or [] if m.get("role") == "orchestrator"), None)
    if not orch or not orch.get("handle"):
        raise TeamError("team state missing orchestrator handle")
    layout = state.get("layout") or DEFAULT_LAYOUT
    tab_title = state.get("orchTabTitle") or tab_titles_for_layout(
        layout, str(orch.get("agentId") or "agent")
    )[0]
    workers_tab_title = state.get("workersTabTitle") or (
        WORKERS_TAB_TITLE if layout == "dual" else None
    )
    # Refresh card comment for remote findability.
    try:
        comment = f'ai-team LIVE — open terminal tab "{tab_title}"'
        if workers_tab_title:
            comment += f' (workers: "{workers_tab_title}")'
        orca_json(
            orca,
            [
                "worktree",
                "set",
                "--worktree",
                f"path:{worktree_path}",
                "--comment",
                comment,
            ],
            check=False,
        )
    except TeamError:
        pass
    if not reveal_team_tab(
        orca,
        orch["handle"],
        tab_title=tab_title,
        worktree_path=worktree_path,
    ):
        raise TeamError(f"could not open team tab ({orch['handle']})")
    print(f"Host focused run {state.get('runId')} → tab '{tab_title}'")
    if workers_tab_title:
        print(f"  workers tab: '{workers_tab_title}'")
    return 0


def reinject_roles(
    orca: str,
    *,
    state: dict[str, Any],
    worktree_path: Path,
    targets: list[dict[str, Any]] | None = None,
    orchestrator_prefix: str | None = None,
    force_role: bool = False,
) -> None:
    members = list(state.get("members") or [])
    orch = next((m for m in members if m.get("role") == "orchestrator"), None)
    if not orch or not orch.get("handle"):
        raise TeamError("team state missing orchestrator")
    run_id = str(state.get("runId") or "")
    objective = str(state.get("objective") or "")
    templates = load_role_templates()
    roster = roster_from_members(members)
    selected = targets if targets is not None else members
    live_handles = list_live_handles(orca, worktree_path)

    for member in selected:
        handle = member.get("handle")
        if not handle:
            continue
        role = member.get("role")
        # Workers: send-once — short reminder unless fresh pane or --force-role.
        if role == "worker" and not member_needs_role_inject(
            member, live_handles=live_handles, force=force_role
        ):
            print(
                f"  reinject reminder → {member.get('title') or member.get('agentId')} "
                "(lean; use --force-role for full worker bible)"
            )
            terminal_send(orca, handle, WORKER_ROLE_REMINDER)
            time.sleep(0.4)
            continue

        prompt = build_role_prompt(
            templates=templates,
            member=member,
            run_id=run_id,
            objective=objective,
            worktree_path=worktree_path,
            orch_handle=str(orch["handle"]),
            roster=roster,
        )
        if role == "orchestrator" and orchestrator_prefix:
            prompt = orchestrator_prefix + "\n\n" + prompt
        elif role == "orchestrator":
            prompt = (
                "CORRECTION: You drifted into doing implementation yourself. "
                "Stop coding. You are orchestrator-only — delegate with "
                "`orca-team assign` (lean) or task-create + worker-start for fresh panes, "
                "then wait on worker_done/ask.\n\n"
                + prompt
            )
        print(f"  reinjecting → {member.get('title') or member.get('agentId')}")
        terminal_send(orca, handle, prompt)
        if role == "worker":
            mark_role_injected(member, str(handle))
        time.sleep(0.4)

    orca_json(
        orca,
        [
            "orchestration",
            "send",
            "--from",
            str(orch["handle"]),
            "--run",
            run_id,
            "--to",
            f"run:{run_id}",
            "--subject",
            "team roster / policy update",
            "--body",
            "Orchestrator must not implement. Workers own coding tasks. "
            f"Current orchestrator handle: {orch['handle']} ({orch.get('agentId')}).",
        ],
        check=False,
    )


def cmd_reinject(args: argparse.Namespace) -> int:
    """Re-send role prompts to the live team (fix orchestrator drift into coding)."""
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state or state.get("status") != "running":
        raise TeamError("no running ai-team; start a team first")
    members = list(state.get("members") or [])
    orch = next((m for m in members if m.get("role") == "orchestrator"), None)
    if not orch:
        raise TeamError("team state missing orchestrator")
    targets = [orch] if args.orchestrator_only else members
    force_role = bool(getattr(args, "force_role", False))
    reinject_roles(
        orca,
        state=state,
        worktree_path=worktree_path,
        targets=targets,
        force_role=force_role,
    )
    save_state(worktree_path, state)
    print("Reinjected role prompts.")
    return 0


def cmd_assign(args: argparse.Namespace) -> int:
    """Lean-assign a task to a roster worker (send-once role + short card)."""
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state or state.get("status") != "running":
        raise TeamError("no running ai-team; start a team first")
    run_id = str(state.get("runId") or "")
    if not run_id:
        raise TeamError("team state missing runId")
    orch = next((m for m in state.get("members") or [] if m.get("role") == "orchestrator"), None)
    if not orch or not orch.get("handle"):
        raise TeamError("team state missing orchestrator handle")
    orch_handle = str(orch["handle"])
    member = resolve_worker_member(state, args.worker)
    agent_id = str(member.get("agentId") or "worker")
    live_handles = list_live_handles(orca, worktree_path)
    dry_run = bool(args.dry_run)
    force_role = bool(args.force_role)
    as_json = bool(args.json)

    # Fresh spawn when deferred / no live handle.
    handle = member.get("handle")
    needs_spawn = bool(
        member.get("deferred")
        or not handle
        or (handle and str(handle) not in live_handles and live_handles)
    )
    planned: dict[str, Any] = {
        "worker": agent_id,
        "runId": run_id,
        "needsSpawn": needs_spawn,
        "needsRole": False,
        "mode": "lean",
        "dryRun": dry_run,
    }

    if needs_spawn and dry_run:
        planned["needsRole"] = True
        planned["mode"] = "role-once"
        planned["handle"] = handle
        planned["dispatchInject"] = False
        planned["note"] = (
            "Would spawn via worker-start --agent (one platform inject possible), "
            "then inject full worker role once and send lean card."
        )
        card_preview = build_lean_task_card(
            goal=(args.spec or "").strip() or "(spawn task)",
            in_scope=args.in_scope or "",
            out_scope=args.out_scope or "",
            done_criteria=args.done or "",
            run_id=run_id,
            task_id="task_DRY",
            dispatch_id="ctx_DRY",
            mode="role-once",
        )
        planned["cardPreview"] = card_preview
        if as_json:
            print(json.dumps(planned, indent=2))
        else:
            print(f"assign dry-run → {agent_id} (would spawn fresh pane)")
            print(f"  mode:        role-once")
            print(f"  needsSpawn:  True")
            print("  dispatch:    without --inject after spawn")
            print("  card:")
            for line in card_preview.splitlines():
                print(f"    {line}")
        return 0

    if needs_spawn and not dry_run:
        # Create task first so worker-start has something to bind (may fat-inject once).
        spec = (args.spec or "").strip()
        if not spec:
            raise TeamError("--spec required when spawning a fresh worker pane")
        task_payload = orca_json(
            orca,
            [
                "orchestration",
                "task-create",
                "--spec",
                f"[{agent_id}] {spec}",
                "--from",
                orch_handle,
                "--run",
                run_id,
            ],
        )
        task = unwrap(task_payload).get("task") or unwrap(task_payload)
        task_id = str(task.get("id") or task.get("taskId") or "")
        if not task_id:
            raise TeamError(f"task-create missing id: {json.dumps(task_payload)[:500]}")
        start_payload = orca_json(
            orca,
            [
                "orchestration",
                "worker-start",
                "--task",
                task_id,
                "--worktree",
                "current",
                "--agent",
                agent_id,
                "--from",
                orch_handle,
                "--run",
                run_id,
            ],
        )
        start_res = unwrap(start_payload)
        worker_info = start_res.get("worker") or start_res
        new_handle = (
            worker_info.get("agent_terminal_handle")
            or worker_info.get("handle")
            or (start_res.get("dispatch") or {}).get("assignee_handle")
        )
        if not new_handle:
            raise TeamError(f"worker-start returned no handle: {json.dumps(start_payload)[:800]}")
        member["handle"] = str(new_handle)
        member["deferred"] = False
        member.pop("deferredReason", None)
        clear_role_injected(member)
        handle = member["handle"]
        live_handles.add(str(handle))
        planned["spawnedHandle"] = handle
        planned["taskId"] = task_id
        # Platform may have injected once; still send lean card with ids if dispatch present.
        dispatch = start_res.get("dispatch") or {}
        dispatch_id = str(dispatch.get("id") or dispatch.get("dispatchId") or "")
        # Mark role: worker-start inject is not our full role bible — inject role once.
        needs_role = True
    else:
        task_id = (args.task_id or "").strip()
        dispatch_id = ""
        needs_role = member_needs_role_inject(
            member, live_handles=live_handles, force=force_role
        )
        if not handle:
            raise TeamError(
                f"worker {agent_id} has no live handle; omit --dry-run to spawn, "
                "or start the team with that worker open"
            )

    planned["needsRole"] = bool(needs_role)
    planned["mode"] = "role-once" if needs_role else "lean"
    planned["handle"] = handle

    spec = (args.spec or "").strip()
    if not spec and not planned.get("taskId"):
        raise TeamError("--spec required (task goal text)")

    if dry_run:
        card_preview = build_lean_task_card(
            goal=spec or "(existing task)",
            in_scope=args.in_scope or "",
            out_scope=args.out_scope or "",
            done_criteria=args.done or "",
            run_id=run_id,
            task_id=planned.get("taskId") or task_id or "task_DRY",
            dispatch_id=dispatch_id or "ctx_DRY",
            mode=planned["mode"],
        )
        planned["cardPreview"] = card_preview
        planned["dispatchInject"] = False
        if as_json:
            print(json.dumps(planned, indent=2))
        else:
            print(f"assign dry-run → {agent_id} handle={handle}")
            print(f"  mode:        {planned['mode']}")
            print(f"  needsRole:   {planned['needsRole']}")
            print(f"  needsSpawn:  {planned['needsSpawn']}")
            print("  dispatch:    without --inject")
            print("  card:")
            for line in card_preview.splitlines():
                print(f"    {line}")
        return 0

    # Role-once for primed/fresh pane (not already handled by worker-start path above
    # when we still need our role bible after spawn).
    if needs_role:
        templates = load_role_templates()
        wait_agent_ready(orca, str(handle), agent_id=agent_id)
        prompt = build_role_prompt(
            templates=templates,
            member=member,
            run_id=run_id,
            objective=str(state.get("objective") or ""),
            worktree_path=worktree_path,
            orch_handle=orch_handle,
            roster=roster_from_members(list(state.get("members") or [])),
        )
        terminal_send(orca, str(handle), prompt)
        mark_role_injected(member, str(handle))
        time.sleep(0.4)

    # Create task + lean dispatch when we did not already create during spawn.
    if planned.get("taskId"):
        task_id = str(planned["taskId"])
        if not dispatch_id:
            show = orca_json(
                orca,
                ["orchestration", "dispatch-show", "--task", task_id],
                check=False,
            )
            if show.get("ok"):
                shown = unwrap(show)
                if isinstance(shown, dict):
                    dispatch_id = str(
                        shown.get("id")
                        or (shown.get("dispatch") or {}).get("id")
                        or ""
                    )
    else:
        if args.task_id:
            task_id = str(args.task_id).strip()
        else:
            task_payload = orca_json(
                orca,
                [
                    "orchestration",
                    "task-create",
                    "--spec",
                    f"[{agent_id}] {spec}",
                    "--from",
                    orch_handle,
                    "--run",
                    run_id,
                ],
            )
            task = unwrap(task_payload).get("task") or unwrap(task_payload)
            task_id = str(task.get("id") or task.get("taskId") or "")
            if not task_id:
                raise TeamError(
                    f"task-create missing id: {json.dumps(task_payload)[:500]}"
                )

        dispatch_payload = orca_json(
            orca,
            [
                "orchestration",
                "dispatch",
                "--task",
                task_id,
                "--to",
                str(handle),
                "--from",
                orch_handle,
                "--run",
                run_id,
                # intentionally NO --inject (lean path)
            ],
        )
        dispatch = unwrap(dispatch_payload).get("dispatch") or unwrap(dispatch_payload)
        dispatch_id = str(dispatch.get("id") or dispatch.get("dispatchId") or "")

    card = build_lean_task_card(
        goal=spec or f"Continue task {task_id}",
        in_scope=args.in_scope or "",
        out_scope=args.out_scope or "",
        done_criteria=args.done or "",
        run_id=run_id,
        task_id=task_id,
        dispatch_id=dispatch_id,
        mode=planned["mode"],
    )
    wait_agent_ready(orca, str(handle), agent_id=agent_id)
    terminal_send(orca, str(handle), card)

    member["lastAssignAt"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    member["lastAssignMode"] = planned["mode"]
    member["lastTaskId"] = task_id
    save_state(worktree_path, state)

    result = {
        "ok": True,
        "worker": agent_id,
        "handle": handle,
        "runId": run_id,
        "taskId": task_id,
        "dispatchId": dispatch_id,
        "mode": planned["mode"],
        "marker": LEAN_ASSIGN_MARKER,
    }
    if as_json:
        print(json.dumps(result, indent=2))
    else:
        print(f"assigned → {agent_id} [{planned['mode']}]")
        print(f"  handle:     {handle}")
        print(f"  taskId:     {task_id}")
        print(f"  dispatchId: {dispatch_id or '(none)'}")
        print(f"  marker:     {LEAN_ASSIGN_MARKER}")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    """Show / init / set / edit user defaults for start roster and models."""
    action = getattr(args, "config_action", None) or "show"
    path = config_path()

    if action == "path":
        print(path)
        return 0

    if action == "show":
        cfg = load_user_config()
        effective = cfg or default_config_dict()
        print(f"config path: {path}")
        print(f"exists: {'yes' if cfg is not None else 'no (using built-in defaults)'}")
        print(json.dumps(effective, indent=2))
        return 0

    if action == "init":
        if path.is_file() and not args.force:
            raise TeamError(
                f"config already exists at {path} (pass --force to overwrite)"
            )
        saved = save_user_config(default_config_dict())
        print(f"wrote {saved}")
        print(json.dumps(load_user_config() or {}, indent=2))
        return 0

    if action == "set":
        cfg = load_user_config() or default_config_dict()
        if getattr(args, "orchestrator", None):
            cfg["orchestrator"] = args.orchestrator
        if getattr(args, "workers", None) is not None and str(args.workers).strip() != "":
            cfg["workers"] = parse_agent_list(str(args.workers), list(DEFAULT_WORKERS))
        models = dict(cfg.get("models") or {})
        if getattr(args, "clear_models", False):
            models = {}
        for aid, model in parse_worker_models(getattr(args, "model", None)).items():
            models[aid] = model
        orch_model = (getattr(args, "orchestrator_model", None) or "").strip()
        if orch_model:
            models[str(cfg["orchestrator"])] = orch_model
        cfg["models"] = models
        saved = save_user_config(cfg)
        print(f"updated {saved}")
        print(json.dumps(load_user_config() or {}, indent=2))
        return 0

    if action == "edit":
        if not path.is_file():
            save_user_config(default_config_dict())
            print(f"created {path}")
        editor = (os.environ.get("EDITOR") or os.environ.get("VISUAL") or "").strip()
        if not editor:
            print(f"No $EDITOR set. Edit manually:\n  {path}")
            return 0
        # EDITOR may be "code --wait" etc.
        cmd = [*editor.split(), str(path)]
        proc = subprocess.run(cmd, check=False)
        if proc.returncode != 0:
            raise TeamError(f"editor exited {proc.returncode}: {' '.join(cmd)}")
        # Re-validate after edit.
        load_user_config()
        print(f"ok — config valid at {path}")
        return 0

    raise TeamError(f"unknown config action '{action}'")


def cmd_set_orchestrator(args: argparse.Namespace) -> int:
    """Replace the orchestrator (rate-limit / model swap) while keeping the same Run."""
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    selector = f"path:{worktree_path}"
    state = load_state(worktree_path)
    if not state or state.get("status") != "running":
        raise TeamError("no running ai-team; start a team first")

    run_id = str(state.get("runId") or "")
    if not run_id:
        raise TeamError("team state missing runId")

    new_agent = args.agent
    if new_agent not in AGENT_LAUNCH:
        raise TeamError(f"unknown agent id '{new_agent}'")
    if not shutil.which(binary_for(new_agent)):
        raise TeamError(f"agent binary not found on PATH: {binary_for(new_agent)}")

    members = list(state.get("members") or [])
    old_orch = next((m for m in members if m.get("role") == "orchestrator"), None)
    if not old_orch:
        raise TeamError("team state missing current orchestrator")

    layout = state.get("layout") or "tabs"
    split_direction = state.get("splitDirection") or "horizontal"
    reason = args.reason or "orchestrator swap (limit / model change)"
    cfg = load_user_config() or default_config_dict()
    new_model = (getattr(args, "model", None) or "").strip() or (
        (cfg.get("models") or {}).get(new_agent)
    )
    new_launch = launch_command(new_agent, model=new_model)

    print(f"Changing orchestrator → {new_agent} ({reason})")
    print(f"  previous: {old_orch.get('agentId')} handle={old_orch.get('handle')}")
    print(f"  launch: `{new_launch}`")

    if is_claude_agent(new_agent):
        ensure_claude_project_trust(worktree_path)

    # Prefer promoting an existing live worker with the same agent id.
    promote = None
    if not args.fresh:
        for member in members:
            if (
                member.get("role") == "worker"
                and member.get("agentId") == new_agent
                and member.get("handle")
            ):
                promote = member
                break

    if promote:
        new_handle = str(promote["handle"])
        print(f"  promoting existing worker pane {new_handle}")
        new_member = {
            **promote,
            "role": "orchestrator",
            "title": f"orchestrator:{new_agent}",
            "agentId": new_agent,
            "launchCommand": new_launch,
            "model": new_model,
        }
    else:
        # Spawn a fresh orchestrator pane/tab.
        # dual/tabs: always a dedicated orch tab. split: pane inside the shared tab.
        if layout == "split" and old_orch.get("handle"):
            term = split_terminal(
                orca,
                from_handle=str(old_orch["handle"]),
                command=new_launch,
                direction=str(split_direction),
            )
            print(f"  split new orchestrator pane {term['handle']}")
        else:
            orch_title = state.get("orchTabTitle") or tab_titles_for_layout(layout, new_agent)[0]
            term = create_terminal(
                orca,
                title=orch_title,
                command=new_launch,
                worktree_selector=selector,
            )
            print(f"  created new orchestrator terminal {term['handle']} (tab '{orch_title}')")
        new_handle = str(term["handle"])
        dismiss_startup_prompts(orca, new_handle, agent_id=new_agent)
        new_member = {
            "role": "orchestrator",
            "agentId": new_agent,
            "title": f"orchestrator:{new_agent}",
            "handle": new_handle,
            "launchCommand": new_launch,
            "model": new_model,
            "tabId": term.get("tabId") or old_orch.get("tabId"),
            "paneKey": term.get("paneKey"),
        }

    # Bind the existing Run to the new coordinator terminal.
    bind = orca_json(
        orca,
        [
            "orchestration",
            "run-use",
            "--id",
            run_id,
            "--from",
            new_handle,
        ],
        check=False,
    )
    if not bind.get("ok"):
        # Fallback: some runtimes only accept bind from inside the pane; try create is wrong.
        err = bind.get("error") or {}
        raise TeamError(
            f"failed to bind run {run_id} to new orchestrator: "
            f"{err.get('code')} {err.get('message')}"
        )
    print(f"  bound run {run_id} → {new_handle}")

    # Rebuild member list: demote old orchestrator, drop promoted worker row if any.
    updated: list[dict[str, Any]] = []
    for member in members:
        if member is old_orch or member.get("handle") == old_orch.get("handle"):
            if args.close_old:
                continue
            demoted = {
                **member,
                "role": "worker",
                "title": f"worker:{member.get('agentId')}-standby",
                "standbyReason": reason,
                "wasOrchestrator": True,
            }
            updated.append(demoted)
            continue
        if promote and member.get("handle") == promote.get("handle"):
            continue
        updated.append(member)
    updated.insert(0, new_member)

    state["members"] = updated
    state["orchestratorHistory"] = list(state.get("orchestratorHistory") or []) + [
        {
            "at": utc_now(),
            "fromAgentId": old_orch.get("agentId"),
            "fromHandle": old_orch.get("handle"),
            "toAgentId": new_agent,
            "toHandle": new_handle,
            "reason": reason,
        }
    ]
    save_state(worktree_path, state)

    if args.close_old and old_orch.get("handle"):
        # In split layout closing with --tab would kill everyone; close pane only.
        close_args = ["terminal", "close", "--terminal", str(old_orch["handle"])]
        if layout != "split":
            # Old orchestrator was its own tab only in tabs layout when alone — still avoid --tab
            # if workers may share? In tabs layout each agent is its own tab, so --tab is OK.
            close_args.append("--tab")
        payload = orca_json(orca, close_args, check=False)
        if payload.get("ok"):
            print(f"  closed previous orchestrator {old_orch.get('handle')}")
        else:
            eprint(f"  warning: could not close old orchestrator: {payload.get('error')}")

    prefix = (
        f"You are the NEW orchestrator for run {run_id} after a swap ({reason}). "
        f"Previous orchestrator was {old_orch.get('agentId')} ({old_orch.get('handle')}). "
        "Continue coordinating — do not re-implement finished worker work. "
        "Delegate with task-create + worker-start/dispatch."
    )
    reinject_roles(
        orca,
        state=state,
        worktree_path=worktree_path,
        orchestrator_prefix=prefix,
    )

    # Notify old orchestrator explicitly if kept.
    if not args.close_old and old_orch.get("handle"):
        terminal_send(
            orca,
            str(old_orch["handle"]),
            (
                f"NOTICE: You are no longer the orchestrator ({reason}). "
                f"New orchestrator is {new_agent} handle `{new_handle}`. "
                "Stand by as a worker. Do not create competing runs. "
                "Wait for dispatched tasks or human instructions."
            ),
        )

    tab_title = state.get("orchTabTitle") or tab_titles_for_layout(layout, new_agent)[0]
    workers_tab_title = state.get("workersTabTitle")
    terminal_rename(orca, new_handle, tab_title)
    if not args.no_open:
        reveal_team_tab(orca, new_handle, tab_title=tab_title, worktree_path=worktree_path)

    try:
        comment = f'ai-team LIVE — orchestrator={new_agent} tab "{tab_title}"'
        if workers_tab_title:
            comment += f' (workers: "{workers_tab_title}")'
        orca_json(
            orca,
            [
                "worktree",
                "set",
                "--worktree",
                selector,
                "--comment",
                comment,
            ],
            check=False,
        )
    except TeamError:
        pass

    print(f"Orchestrator is now {new_agent} ({new_handle}) for run {run_id}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state:
        print(f"No ai-team state in {worktree_path / STATE_DIRNAME / STATE_FILENAME}")
        return 1

    print(f"AI team @ {worktree_path}")
    print(f"  status:    {state.get('status')}")
    print(f"  mode:      {state.get('mode')}")
    print(f"  layout:    {state.get('layout', 'tabs')}")
    print(f"  runId:     {state.get('runId')}")
    print(f"  objective: {state.get('objective')}")
    print(f"  startedAt: {state.get('startedAt')}")
    watch_pid = state.get("watchPid")
    if watch_pid:
        try:
            alive = pid_alive(int(watch_pid))
        except (TypeError, ValueError):
            alive = False
        print(
            f"  watch:     pid {watch_pid} [{'alive' if alive else 'dead'}] "
            f"log={state.get('watchLog') or watch_log_path_for(worktree_path)}"
        )
    elif state.get("watchEnabled") is False:
        print("  watch:     off")
    else:
        print("  watch:     (none)")
    print("  members:")
    live = orca_json(
        orca,
        ["terminal", "list", "--worktree", f"path:{worktree_path}"],
        check=False,
    )
    live_handles: set[str] = set()
    if live.get("ok"):
        result = unwrap(live)
        terms = result.get("terminals") or result.get("items") or result
        if isinstance(terms, list):
            for term in terms:
                handle = term.get("handle")
                if handle:
                    live_handles.add(handle)

    for member in state.get("members") or []:
        handle = member.get("handle")
        presence = "live" if handle in live_handles else ("unknown" if not live.get("ok") else "missing")
        role_note = ""
        if member.get("role") == "worker":
            inj = member.get("roleInjectedHandle")
            if inj and handle and str(inj) == str(handle):
                role_note = " role=injected"
            elif handle:
                role_note = " role=fresh"
            mode = member.get("lastAssignMode")
            if mode:
                role_note += f" lastAssign={mode}"
        print(
            f"    - {member.get('role')}:{member.get('agentId')} "
            f"handle={handle} [{presence}]{role_note}"
        )

    if state.get("runId"):
        inbox = orca_json(
            orca,
            ["orchestration", "inbox", "--limit", "10"],
            check=False,
        )
        if inbox.get("ok"):
            messages = unwrap(inbox).get("messages") or unwrap(inbox).get("items") or []
            if isinstance(messages, list):
                print(f"  inbox sample: {len(messages)} message(s)")
            else:
                print("  inbox: ok")
        else:
            err = inbox.get("error") or {}
            print(f"  inbox: unavailable ({err.get('code', 'error')})")
    return 0


def cmd_send(args: argparse.Namespace) -> int:
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state or not state.get("runId"):
        raise TeamError("no running ai-team state with runId; run orca-team start first")

    run_id = state["runId"]
    orch = next((m for m in state.get("members") or [] if m.get("role") == "orchestrator"), None)
    if not orch:
        raise TeamError("team state missing orchestrator member")

    to = args.to
    if to in ("run", "team", "@run"):
        to = f"run:{run_id}"
    elif to.startswith("worker:"):
        agent_id = to.split(":", 1)[1]
        match = next(
            (
                m
                for m in state.get("members") or []
                if m.get("role") == "worker" and m.get("agentId") == agent_id
            ),
            None,
        )
        if not match:
            raise TeamError(f"no worker named {agent_id} in team state")
        to = match["handle"]

    cmd = [
        "orchestration",
        "send",
        "--subject",
        args.subject,
        "--body",
        args.body,
        "--from",
        orch["handle"],
        "--run",
        run_id,
        "--to",
        to,
    ]
    if args.type:
        cmd.extend(["--type", args.type])
    payload = orca_json(orca, cmd)
    print(json.dumps(unwrap(payload), indent=2))
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state:
        raise TeamError("no ai-team state to stop")

    closed = []
    errors = []
    layout = state.get("layout") or "tabs"
    members = list(state.get("members") or [])

    # Capture continuity BEFORE closing panes (needs live orch handle for inbox/tasks).
    handoff_path: Path | None = None
    if not getattr(args, "no_handoff", False):
        handoff_path = write_session_handoff(orca, worktree_path=worktree_path, state=state)
        if handoff_path:
            print(f"  wrote session handoff: {handoff_path}")
            state["handoffPath"] = str(handoff_path)
            state["handoffWrittenAt"] = utc_now()
        else:
            eprint("  warning: session handoff was not written")
    else:
        print("  handoff: skipped (--no-handoff)")

    old_watch_pid = state.get("watchPid")
    if stop_watch_process(state):
        print(f"  stopped watch pid {old_watch_pid}")
    elif old_watch_pid:
        print(f"  watch pid {old_watch_pid} already dead")
    if delete_watch_log(worktree_path):
        print(f"  deleted watch log {watch_log_path_for(worktree_path)}")

    def _close_tab(handle: str, label: str) -> None:
        payload = orca_json(
            orca,
            ["terminal", "close", "--terminal", handle, "--tab"],
            check=False,
        )
        if payload.get("ok"):
            closed.append(handle)
            print(f"  closed {label} ({handle})")
        else:
            err = payload.get("error") or {}
            errors.append(f"{handle}: {err.get('code')} {err.get('message')}")
            eprint(f"  warning: could not close {label}: {err.get('message')}")

    orch = next((m for m in members if m.get("role") == "orchestrator"), None)
    first_worker = next(
        (
            m
            for m in members
            if m.get("role") == "worker" and m.get("handle") and not m.get("deferred")
        ),
        None,
    )

    # split: one shared tab. dual: orch tab + workers tab. Avoid closing N panes.
    if layout == "split" and not args.keep_orchestrator:
        target = orch or (members[0] if members else None)
        if target and target.get("handle"):
            _close_tab(str(target["handle"]), f"shared team tab via {target.get('title')}")
        members = []
    elif layout == "dual":
        if not args.keep_orchestrator and orch and orch.get("handle"):
            _close_tab(str(orch["handle"]), f"orchestrator tab via {orch.get('title')}")
        workers_handle = state.get("workersTabHandle") or (
            first_worker.get("handle") if first_worker else None
        )
        if workers_handle:
            _close_tab(str(workers_handle), "workers tab")
        members = []  # both tabs closed (or workers-only when keep_orchestrator)

    for member in members:
        handle = member.get("handle")
        if not handle:
            continue
        if args.keep_orchestrator and member.get("role") == "orchestrator":
            continue
        # In split+keep-orchestrator, close only worker panes (no --tab).
        close_args = ["terminal", "close", "--terminal", handle]
        if layout not in {"split", "dual"}:
            close_args.append("--tab")
        payload = orca_json(orca, close_args, check=False)
        if payload.get("ok"):
            closed.append(handle)
            print(f"  closed {member.get('title')} ({handle})")
        else:
            err = payload.get("error") or {}
            errors.append(f"{handle}: {err.get('code')} {err.get('message')}")
            eprint(f"  warning: could not close {handle}: {err.get('message')}")

    state["status"] = "stopped"
    state["stoppedAt"] = utc_now()
    state["closedHandles"] = closed
    state["watchLog"] = None
    save_state(worktree_path, state)

    try:
        orca_json(
            orca,
            [
                "worktree",
                "set",
                "--worktree",
                f"path:{worktree_path}",
                "--comment",
                "ai-team stopped",
            ],
            check=False,
        )
    except TeamError:
        pass

    print(f"Stopped team run {state.get('runId')} (closed {len(closed)} tab(s)).")
    if handoff_path:
        print(f"  handoff:  {handoff_path}")
        print("  next:     orca-team start   # loads AI-TEAM-HANDOFF.md into orchestrator")
    if errors and not closed:
        return 1
    return 0


def _parse_orca_time(value: Any) -> datetime | None:
    if not value or not isinstance(value, str):
        return None
    text = value.strip().replace(" ", "T")
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def list_dispatched_tasks(orca: str, *, run_id: str, orch_handle: str) -> list[dict[str, Any]]:
    payload = orca_json(
        orca,
        [
            "orchestration",
            "task-list",
            "--run",
            run_id,
            "--status",
            "dispatched",
            "--from",
            orch_handle,
        ],
        check=False,
    )
    if not payload.get("ok"):
        return []
    result = unwrap(payload)
    tasks = result if isinstance(result, list) else result.get("tasks") or result.get("items") or []
    return [t for t in tasks if isinstance(t, dict)]


def show_dispatch(orca: str, *, task_id: str, orch_handle: str) -> dict[str, Any] | None:
    payload = orca_json(
        orca,
        [
            "orchestration",
            "dispatch-show",
            "--task",
            task_id,
            "--from",
            orch_handle,
        ],
        check=False,
    )
    if not payload.get("ok"):
        return None
    result = unwrap(payload)
    dispatch = result.get("dispatch") if isinstance(result, dict) else None
    return dispatch if isinstance(dispatch, dict) else None


def list_unread_questions(orca: str, *, orch_handle: str, run_id: str = "") -> list[dict[str, Any]]:
    """Unread question/ask messages waiting on the orchestrator.

    Note: ``orchestration check`` does **not** accept ``--from``; bind the run
    first with ``run-use --from <orch>``, then ``check --peek --types question``.
    """
    _ = orch_handle  # binding happens via run-use before this is called
    cmd = ["orchestration", "check", "--peek", "--types", "question"]
    if run_id:
        cmd.extend(["--run", run_id])
    payload = orca_json(orca, cmd, check=False)
    if not payload.get("ok"):
        # Fallback: inbox sample (may include already-read items).
        payload = orca_json(
            orca,
            ["orchestration", "inbox", "--limit", "30"],
            check=False,
        )
        if not payload.get("ok"):
            return []
        result = unwrap(payload)
        msgs = result.get("messages") or result.get("items") or []
        out = []
        for m in msgs if isinstance(msgs, list) else []:
            if not isinstance(m, dict):
                continue
            if str(m.get("type") or "") != "question":
                continue
            if m.get("read") in {1, True, "1"}:
                continue
            out.append(m)
        return out
    result = unwrap(payload)
    msgs = result if isinstance(result, list) else result.get("messages") or result.get("items") or []
    return [m for m in msgs if isinstance(m, dict)]


def terminal_seems_idle(orca: str, handle: str, *, timeout_ms: int = 8000) -> bool | None:
    """Best-effort: True if tui-idle within timeout, False if timed out, None on error."""
    payload = orca_json(
        orca,
        [
            "terminal",
            "wait",
            "--terminal",
            handle,
            "--for",
            "tui-idle",
            "--timeout-ms",
            str(timeout_ms),
        ],
        check=False,
    )
    if payload.get("ok"):
        return True
    err = (payload.get("error") or {}).get("code")
    if err == "timeout":
        return False
    return None


def _redirect_watch_log(log_file: str | None) -> None:
    """When spawned in background, write heartbeats to a log file instead of /dev/null."""
    if not log_file:
        return
    path = Path(log_file)
    path.parent.mkdir(parents=True, exist_ok=True)
    # Line-buffered so `tail -f` shows watching heartbeats promptly.
    log_fh = open(path, "a", encoding="utf-8", buffering=1)
    sys.stdout = log_fh  # type: ignore[assignment]
    sys.stderr = log_fh  # type: ignore[assignment]


def cmd_watch(args: argparse.Namespace) -> int:
    """Monitor dispatched workers; nudge when they go quiet without worker_done."""
    _redirect_watch_log(getattr(args, "log_file", None))
    orca = resolve_orca()
    cwd = Path.cwd()
    wt = find_worktree(orca, cwd)
    worktree_path = Path(wt["path"]).resolve()
    state = load_state(worktree_path)
    if not state or state.get("status") != "running":
        raise TeamError("no running ai-team; start a team first")
    run_id = str(state.get("runId") or "")
    orch = next((m for m in state.get("members") or [] if m.get("role") == "orchestrator"), None)
    if not orch or not orch.get("handle"):
        raise TeamError("team state missing orchestrator handle")
    orch_handle = str(orch["handle"])

    # Ensure run is bound for task-list.
    orca_json(
        orca,
        ["orchestration", "run-use", "--id", run_id, "--from", orch_handle],
        check=False,
    )

    stale_seconds = max(60, int(args.stale_minutes * 60))
    interval = max(15, int(args.interval))
    nudge = not args.no_nudge
    rounds = 1 if args.once else max(1, int(args.rounds) if args.rounds else 10**9)

    print(
        f"watching run {run_id} (stale>{args.stale_minutes}m, "
        f"nudge={'on' if nudge else 'off'}, once={args.once}, interval={interval}s)",
        flush=True,
    )

    for round_idx in range(rounds):
        if not team_still_running(worktree_path, run_id):
            print(f"[{utc_now()}] watching stopped — team ended or run changed", flush=True)
            return 0
        now = datetime.now(timezone.utc)
        tasks = list_dispatched_tasks(orca, run_id=run_id, orch_handle=orch_handle)
        stale_rows: list[dict[str, Any]] = []
        for task in tasks:
            task_id = str(task.get("id") or "")
            if not task_id:
                continue
            dispatch_raw = show_dispatch(orca, task_id=task_id, orch_handle=orch_handle)
            if dispatch_raw is None:
                # Task listed dispatched but dispatch already settled (worker_done landed).
                print(
                    f"[{utc_now()}] settled? {task_id} (dispatch-show null — "
                    "likely worker_done already; do not nudge as quiet)",
                    flush=True,
                )
                continue
            dispatch = dispatch_raw or {}
            assignee = str(
                dispatch.get("assignee_handle")
                or task.get("assignee_handle")
                or ""
            )
            dispatch_id = str(dispatch.get("id") or task.get("dispatch_id") or "")
            started = _parse_orca_time(dispatch.get("dispatched_at") or dispatch.get("created_at"))
            heartbeat = _parse_orca_time(dispatch.get("last_heartbeat_at"))
            age_ref = heartbeat or started
            age_s = (now - age_ref).total_seconds() if age_ref else None
            idle = None
            if assignee and args.idle_check:
                idle = terminal_seems_idle(orca, assignee, timeout_ms=args.idle_timeout_ms)
            is_stale = False
            if age_s is not None and age_s >= stale_seconds:
                is_stale = True
            if idle is True and age_s is not None and age_s >= min(120, stale_seconds):
                # Idle at prompt with an open dispatch is a strong "forgot worker_done" signal.
                is_stale = True
            row = {
                "taskId": task_id,
                "dispatchId": dispatch_id,
                "assignee": assignee,
                "ageSeconds": int(age_s) if age_s is not None else None,
                "heartbeat": dispatch.get("last_heartbeat_at"),
                "idle": idle,
                "stale": is_stale,
                "spec": (task.get("spec") or "")[:120],
            }
            marker = "STALE" if is_stale else "ok"
            print(
                f"[{utc_now()}] {marker} {task_id} dispatch={dispatch_id or '-'} "
                f"assignee={assignee or '-'} age={row['ageSeconds']}s idle={idle}",
                flush=True,
            )
            if is_stale:
                stale_rows.append(row)

        # Unanswered worker asks freeze the assignee — nudge orchestrator to reply.
        pending_questions = list_unread_questions(
            orca, orch_handle=orch_handle, run_id=run_id
        )
        if pending_questions:
            print(
                f"[{utc_now()}] QUESTIONS pending={len(pending_questions)} "
                f"(workers blocked on ask until orchestrator replies)",
                flush=True,
            )
            for q in pending_questions[:5]:
                qid = str(q.get("id") or "")
                body = str(q.get("body") or q.get("question") or "")[:100]
                print(f"  question {qid}: {body}", flush=True)
            if nudge:
                q_lines = []
                for q in pending_questions[:8]:
                    qid = str(q.get("id") or "UNKNOWN")
                    body = str(q.get("body") or "")[:160]
                    q_lines.append(f"- {qid}: {body}")
                reminder = (
                    "WATCHDOG: unanswered worker ask/question mail is blocking workers.\n"
                    "Reply NOW before anything else:\n"
                    "  orca orchestration check --peek --types question --json\n"
                    "  orca orchestration reply --id <msg_id> --body \"<decisive answer>\" --json\n\n"
                    "Pending:\n"
                    + "\n".join(q_lines)
                )
                print(f"  nudging orchestrator {orch_handle} about pending questions", flush=True)
                try:
                    terminal_send(orca, orch_handle, reminder, retries=1)
                except TeamError as exc:
                    eprint(f"  warning: could not nudge orchestrator: {exc}")

        next_hint = "" if args.once else f"; next check in {interval}s"
        print(
            f"[{utc_now()}] watching… open_dispatches={len(tasks)} "
            f"stale={len(stale_rows)} questions={len(pending_questions)}{next_hint}",
            flush=True,
        )

        if stale_rows and nudge:
            for row in stale_rows:
                task_id = row["taskId"]
                dispatch_id = row["dispatchId"] or "UNKNOWN"
                assignee = row["assignee"]
                if not assignee:
                    continue
                reminder = (
                    f"MONITOR NUDGE: Task {task_id} (dispatch {dispatch_id}) is still open "
                    f"and you look idle/quiet. If you are done or blocked, report NOW.\n\n"
                    f"If finished:\n"
                    f"orca orchestration send --type worker_done --subject \"done\" "
                    f"--body \"<what you did / found / left>\" --task-id {task_id} "
                    f"--dispatch-id {dispatch_id} --outcome succeeded "
                    f"--files-modified \"path/a\" --json\n\n"
                    f"If failed: same with --outcome failed\n"
                    f"If blocked: orca orchestration ask --question \"...\" --timeout-ms 600000 --json"
                )
                print(f"  nudging worker {assignee}", flush=True)
                try:
                    terminal_send(orca, assignee, reminder, retries=2)
                except TeamError as exc:
                    eprint(f"  warning: could not nudge {assignee}: {exc}")
                # Also mail the run so the orchestrator sees it in check.
                orca_json(
                    orca,
                    [
                        "orchestration",
                        "send",
                        "--from",
                        orch_handle,
                        "--run",
                        run_id,
                        "--to",
                        f"run:{run_id}",
                        "--subject",
                        f"stale worker: {task_id}",
                        "--body",
                        (
                            f"Watchdog: {task_id} / {dispatch_id} assigned to {assignee} "
                            f"looks stale (age={row['ageSeconds']}s, idle={row['idle']}). "
                            "Nudge sent to worker. Do not implement their work — wait or reassign."
                        ),
                    ],
                    check=False,
                )
            # Ping orchestrator TUI too.
            try:
                terminal_send(
                    orca,
                    orch_handle,
                    (
                        "WATCHDOG: possible stale dispatches. "
                        f"Count={len(stale_rows)}. BEFORE saying a worker is quiet, run:\n"
                        "  orca orchestration check --peek --types worker_done,question --json\n"
                        "  orca orchestration task-list --status dispatched --brief --json\n"
                        "  orca orchestration dispatch-show --task <id> --json\n"
                        "If dispatch-show is null or worker_done already exists, the work is DONE "
                        "(idle TUI after worker_done is normal). Do not reassign completed work."
                    ),
                    retries=1,
                )
            except TeamError as exc:
                eprint(f"  warning: could not ping orchestrator: {exc}")

        if args.once or round_idx + 1 >= rounds:
            break
        # Sleep in chunks so stop can be noticed quickly.
        slept = 0
        while slept < interval:
            if not team_still_running(worktree_path, run_id):
                print(
                    f"[{utc_now()}] watching stopped — team ended or run changed",
                    flush=True,
                )
                return 0
            step = min(5, interval - slept)
            time.sleep(step)
            slept += step

    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="orca-team",
        description="Open a multi-agent Orca team room (orchestrator + workers) in the current worktree.",
    )
    parser.add_argument(
        "-V",
        "--version",
        action="version",
        version=f"%(prog)s {package_version()}",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor", help="Check Orca runtime, orchestration, and agent binaries")
    doctor.set_defaults(func=cmd_doctor)

    start = sub.add_parser("start", help="Start orchestrator + workers in the current worktree")
    start.add_argument(
        "--orchestrator",
        default=None,
        choices=sorted(AGENT_LAUNCH),
        help=(
            "Orchestrator agent id (default: user config, else "
            f"{DEFAULT_ORCHESTRATOR})"
        ),
    )
    start.add_argument(
        "--workers",
        default=None,
        help=(
            "Comma-separated worker agent ids (default: user config, else "
            f"{','.join(DEFAULT_WORKERS)})"
        ),
    )
    start.add_argument(
        "--orchestrator-model",
        default="",
        help="Provider/CLI model id for the orchestrator this run (overrides config)",
    )
    start.add_argument(
        "--worker-models",
        default="",
        help="Per-worker models as agent=model pairs, e.g. pi=openai/gpt-4o,grok=grok-4",
    )
    start.add_argument(
        "--save-defaults",
        action="store_true",
        help="After a successful start, write effective orch/workers/models to user config",
    )
    start.add_argument("--objective", default="", help="Team objective / run objective")
    start.add_argument("--mode", choices=["room", "supervise"], default="room")
    start.add_argument("--task", default="", help="With --mode supervise, task spec for each worker")
    start.add_argument(
        "--layout",
        choices=["dual", "split", "tabs"],
        default=DEFAULT_LAYOUT,
        help=(
            "dual = orchestrator tab + shared workers tab (default); "
            "split = all agents in one tab; tabs = one tab per agent"
        ),
    )
    start.add_argument(
        "--dual-tab",
        action="store_true",
        help="Alias for --layout dual (orchestrator alone; all workers in one tab)",
    )
    start.add_argument(
        "--same-tab",
        action="store_true",
        help="Alias for --layout split (open workers as panes in the orchestrator tab)",
    )
    start.add_argument(
        "--split-direction",
        choices=["horizontal", "vertical"],
        default="horizontal",
        help="Split direction for --layout dual/split (default: horizontal)",
    )
    start.add_argument("--force", action="store_true", help="Start even if ai-team.json says running")
    start.add_argument(
        "--no-open",
        action="store_true",
        help="Do not auto-focus/switch to the team tab in the Orca UI (default: open)",
    )
    start.add_argument(
        "--watch",
        action=argparse.BooleanOptionalAction,
        default=True,
        help=(
            "Background worker watchdog after start (default: on). "
            "Nudges idle/stale workers missing worker_done. Use --no-watch to disable."
        ),
    )
    start.add_argument(
        "--no-handoff",
        action="store_true",
        help=f"Do not load prior {HANDOFF_FILENAME} into the orchestrator prompt",
    )
    start.add_argument(
        "--watch-interval",
        type=int,
        default=DEFAULT_WATCH_INTERVAL,
        help=f"Seconds between auto-watch scans (default: {DEFAULT_WATCH_INTERVAL})",
    )
    start.add_argument(
        "--watch-stale-minutes",
        type=float,
        default=DEFAULT_WATCH_STALE_MINUTES,
        help=f"Auto-watch stale threshold in minutes (default: {DEFAULT_WATCH_STALE_MINUTES})",
    )
    start.add_argument(
        "--min-remaining",
        type=float,
        default=DEFAULT_MIN_REMAINING_PERCENT,
        help=(
            "Do not open worker panes below this remaining usage %% "
            f"(default: {DEFAULT_MIN_REMAINING_PERCENT}). Grok/Claude probed; others unknown=allow."
        ),
    )
    start.add_argument(
        "--ignore-quota",
        action="store_true",
        help="Open all requested workers even if usage probe says remaining is low",
    )
    start.set_defaults(func=cmd_start)

    status = sub.add_parser("status", help="Show team state for the current worktree")
    status.set_defaults(func=cmd_status)

    config_cmd = sub.add_parser(
        "config",
        help="Show/edit lasting start defaults (~/.config/orca-ai-team/config.json)",
    )
    config_sub = config_cmd.add_subparsers(dest="config_action", required=True)

    config_show = config_sub.add_parser("show", help="Print config path + effective JSON")
    config_show.set_defaults(func=cmd_config, config_action="show")

    config_path_p = config_sub.add_parser("path", help="Print config file path only")
    config_path_p.set_defaults(func=cmd_config, config_action="path")

    config_init = config_sub.add_parser(
        "init", help="Write built-in defaults to the config file"
    )
    config_init.add_argument(
        "--force", action="store_true", help="Overwrite an existing config file"
    )
    config_init.set_defaults(func=cmd_config, config_action="init")

    config_set = config_sub.add_parser("set", help="Update orchestrator / workers / models")
    config_set.add_argument(
        "--orchestrator",
        default=None,
        choices=sorted(AGENT_LAUNCH),
        help="Default orchestrator agent id",
    )
    config_set.add_argument(
        "--workers",
        default=None,
        help="Comma-separated default worker agent ids",
    )
    config_set.add_argument(
        "--orchestrator-model",
        default="",
        help="Default model id for the orchestrator agent",
    )
    config_set.add_argument(
        "--model",
        default="",
        help="Set model(s) as agent=model pairs (repeatable via comma list)",
    )
    config_set.add_argument(
        "--clear-models",
        action="store_true",
        help="Clear all stored model overrides before applying --model",
    )
    config_set.set_defaults(func=cmd_config, config_action="set")

    config_edit = config_sub.add_parser("edit", help="Open config in $EDITOR")
    config_edit.set_defaults(func=cmd_config, config_action="edit")

    assign = sub.add_parser(
        "assign",
        help=(
            "Lean-assign a task to a roster worker: role once per fresh pane, "
            "then short task card (no fat dispatch --inject)"
        ),
    )
    assign.add_argument(
        "--worker",
        required=True,
        help="Worker agent id or terminal handle from the team roster",
    )
    assign.add_argument(
        "--spec",
        default="",
        help="Task goal/spec text (required unless --task-id on a primed pane)",
    )
    assign.add_argument("--task-id", default="", help="Reuse an existing orchestration task id")
    assign.add_argument("--in-scope", default="", help="In-scope paths (card field)")
    assign.add_argument("--out-scope", default="", help="Out-of-scope paths (card field)")
    assign.add_argument("--done", default="", help="Done criteria (card field)")
    assign.add_argument(
        "--force-role",
        action="store_true",
        help="Re-send the full worker role bible before the card",
    )
    assign.add_argument(
        "--dry-run",
        action="store_true",
        help="Print planned role/dispatch/card actions without sending",
    )
    assign.add_argument("--json", action="store_true", help="Emit JSON")
    assign.set_defaults(func=cmd_assign)

    usage_cmd = sub.add_parser(
        "usage",
        help="Probe remaining usage/quota for roster agents (grok/claude)",
    )
    usage_cmd.add_argument(
        "--agents",
        default="",
        help="Comma-separated agent ids (default: current team roster or start defaults)",
    )
    usage_cmd.add_argument(
        "--min-remaining",
        type=float,
        default=DEFAULT_MIN_REMAINING_PERCENT,
        help=f"Mark LOW below this remaining %% (default: {DEFAULT_MIN_REMAINING_PERCENT})",
    )
    usage_cmd.add_argument("--json", action="store_true", help="Emit JSON")
    usage_cmd.set_defaults(func=cmd_usage)

    open_cmd = sub.add_parser(
        "open",
        help="Focus the running team tab in Orca UI and raise the Orca window",
    )
    open_cmd.set_defaults(func=cmd_open)

    reinject = sub.add_parser(
        "reinject",
        help="Re-send role prompts (use when orchestrator starts coding instead of delegating)",
    )
    reinject.add_argument(
        "--orchestrator-only",
        action="store_true",
        help="Only reinject the orchestrator prompt",
    )
    reinject.add_argument(
        "--force-role",
        action="store_true",
        help="Workers: re-send full role bible (default is short lean reminder)",
    )
    reinject.set_defaults(func=cmd_reinject)

    set_orch = sub.add_parser(
        "set-orchestrator",
        help="Change orchestrator on a live team (rate-limit / model swap) without losing the Run",
    )
    set_orch.add_argument(
        "--agent",
        required=True,
        choices=sorted(AGENT_LAUNCH),
        help="New orchestrator agent id (e.g. claude-sonnet, grok, claude-opus)",
    )
    set_orch.add_argument(
        "--reason",
        default="",
        help="Why the swap happened (shown to agents), e.g. 'opus rate limit'",
    )
    set_orch.add_argument(
        "--fresh",
        action="store_true",
        help="Always spawn a new pane/tab instead of promoting an existing worker",
    )
    set_orch.add_argument(
        "--model",
        default="",
        help="Model id for the new orchestrator launch (else user config models)",
    )
    set_orch.add_argument(
        "--close-old",
        action="store_true",
        help="Close the previous orchestrator pane/tab after swap (default: keep as standby worker)",
    )
    set_orch.add_argument(
        "--no-open",
        action="store_true",
        help="Do not auto-focus the team tab after swap",
    )
    set_orch.set_defaults(func=cmd_set_orchestrator)

    watch = sub.add_parser(
        "watch",
        help="Monitor dispatched workers; nudge when they go quiet without worker_done",
    )
    watch.add_argument(
        "--once",
        action="store_true",
        help="Scan once and exit (default: loop)",
    )
    watch.add_argument(
        "--interval",
        type=int,
        default=60,
        help="Seconds between scans when looping (default: 60)",
    )
    watch.add_argument(
        "--rounds",
        type=int,
        default=0,
        help="Max loop rounds when not --once (0 = until interrupted)",
    )
    watch.add_argument(
        "--stale-minutes",
        type=float,
        default=15.0,
        help="Mark a dispatch stale after this many minutes without progress (default: 15)",
    )
    watch.add_argument(
        "--idle-check",
        action="store_true",
        help="Also treat tui-idle workers with open dispatches as stale",
    )
    watch.add_argument(
        "--idle-timeout-ms",
        type=int,
        default=8000,
        help="Timeout for --idle-check tui-idle probe (default: 8000)",
    )
    watch.add_argument(
        "--no-nudge",
        action="store_true",
        help="Report only; do not send reminder prompts",
    )
    watch.add_argument(
        "--log-file",
        default="",
        help="Append watching heartbeats to this file (used by background start)",
    )
    watch.set_defaults(func=cmd_watch)

    send = sub.add_parser("send", help="Send a message on the team run")
    send.add_argument("--to", default="run", help="run | worker:<id> | handle | run:<id>")
    send.add_argument("--subject", required=True)
    send.add_argument("--body", required=True)
    send.add_argument("--type", default="")
    send.set_defaults(func=cmd_send)

    stop = sub.add_parser(
        "stop",
        help=f"Close team terminals, write {HANDOFF_FILENAME}, mark state stopped",
    )
    stop.add_argument(
        "--keep-orchestrator",
        action="store_true",
        help="Close workers only; leave orchestrator tab open",
    )
    stop.add_argument(
        "--no-handoff",
        action="store_true",
        help=f"Do not write {HANDOFF_FILENAME} for the next team start",
    )
    stop.set_defaults(func=cmd_stop)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except TeamError as exc:
        eprint(f"error: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
